<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="using:ReWASD.UI.Mac.Tester"
             xmlns:art="using:ReWASD.UI.Mac.Art"
             x:Class="ReWASD.UI.Mac.Tester.TesterView">

    <UserControl.Styles>
        <Style Selector="TextBlock.h">
            <Setter Property="Foreground" Value="#C9D1DE" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>
        <Style Selector="Border.bar">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="13" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource BrushCyan}" />
        </Style>
        <Style Selector="Border.rule">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#262B36" />
            <Setter Property="Margin" Value="0,10" />
        </Style>
        <Style Selector="TextBlock.big">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
        </Style>
        <Style Selector="TextBlock.val">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="Foreground" Value="#E3E8F1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
        </Style>
        <Style Selector="TextBlock.soft">
            <Setter Property="Foreground" Value="#8E9BAE" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.col">
            <Setter Property="Foreground" Value="#5F6B7E" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="BorderBrush" Value="#262B35" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#171A21" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#232833" />
            <Setter Property="Foreground" Value="#D5DCE8" />
            <Setter Property="BorderBrush" Value="#343B49" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E3442" />
            <Setter Property="BorderBrush" Value="#E9C46A" />
        </Style>
        <Style Selector="ToggleButton.chip">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#232833" />
            <Setter Property="Foreground" Value="#D5DCE8" />
            <Setter Property="BorderBrush" Value="#343B49" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#E9C46A" />
            <Setter Property="Foreground" Value="#14161B" />
        </Style>
        <Style Selector="ProgressBar.pressure">
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
            <Setter Property="Background" Value="#10131A" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.row"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="6,3" /><Setter Property="Margin" Value="0,0,0,1" /></Style>
        <Style Selector="Border.row.down"><Setter Property="Background" Value="#1A3B2C" /></Style>
        <!-- The reaction-test box: click inside it to start; it changes colour with the state of the game -->
        <Style Selector="Button.react">
            <Setter Property="Background" Value="#1B1F28" />
            <Setter Property="BorderBrush" Value="#2A303C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.react:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#1B1F28" /><Setter Property="BorderBrush" Value="#E9C46A" /></Style>
        <Style Selector="Button.react.wait /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#4A3A18" /></Style>
        <Style Selector="Button.react.wait:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#4A3A18" /></Style>
        <Style Selector="Button.react.go /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#0E7A43" /></Style>
        <Style Selector="Button.react.go:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#0E7A43" /></Style>
        <Style Selector="Button.react.bad /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#6B2323" /></Style>
        <Style Selector="Button.react.bad:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#6B2323" /></Style>
        <Style Selector="Button.react.done /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#1F3A5A" /></Style>
        <Style Selector="Button.react.done:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#1F3A5A" /></Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- One trigger: how far it is pulled, and where along the pull it reported (a red mark is a stretch it skipped) -->
        <DataTemplate x:Key="TriggerPanel">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Classes="big" FontSize="18" />
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar Classes="pressure" Minimum="0" Maximum="1" Value="{Binding Value}" Height="12" Margin="0,6,0,8" />
                <t:Histogram Height="56" Values="{Binding Travel}" StartLabel="0%" EndLabel="100% pull" FlagGaps="True" BarColor="#2EC4B6"
                             ToolTip.Tip="Pull the trigger slowly all the way. Each bar counts the readings in one twentieth of the pull; a red mark is a stretch the trigger jumped over." />
                <UniformGrid Columns="3" Margin="0,4,0,0">
                    <TextBlock Text="{Binding PeakText}" Classes="mono" FontSize="11" />
                    <TextBlock Text="{Binding PressesText}" Classes="mono" FontSize="11" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StepsText}" Classes="mono" FontSize="11" Foreground="#8E9BAE" HorizontalAlignment="Right" />
                </UniformGrid>
            </StackPanel>
        </DataTemplate>

        <!-- The buttons on one half of the pad: state, count and hold times -->
        <DataTemplate x:Key="ButtonRows">
            <StackPanel>
                <Grid ColumnDefinitions="22,*,46,64,104" Margin="6,0,6,4">
                    <TextBlock Grid.Column="1" Text="BUTTON" Classes="col" />
                    <TextBlock Grid.Column="2" Text="PRESSES" Classes="col" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="HOLD" Classes="col" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="SHORT – LONG" Classes="col" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="row" Classes.down="{Binding IsDown}">
                                <Grid ColumnDefinitions="22,*,46,64,104">
                                    <Ellipse Width="11" Height="11" Fill="Transparent" Stroke="#3A4150" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <Ellipse Width="11" Height="11" Fill="#2EF2A0" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding IsDown}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Classes="mono" FontSize="11.5" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BounceText}" Classes="mono" FontSize="10.5" Foreground="#FFAA00" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   ToolTip.Tip="A bounce is a release and press less than 30 ms apart: a worn switch, not a finger." />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding PressesText}" Classes="mono" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding HoldText}" Classes="mono" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding RangeText}" Classes="mono" Foreground="#8E9BAE" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Background="#0E1015">

        <!-- Title bar of the tester -->
        <Border Grid.Row="0" Padding="28,14" BorderBrush="#262B35" BorderThickness="0,0,0,1" Background="#14171D">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BrushCyan}">
                        <PathIcon Data="{StaticResource IconTester}" Width="22" Height="22" Foreground="#14161B" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CONTROLLER TESTER" FontSize="16" FontWeight="Bold" LetterSpacing="1.5" Foreground="#FFFFFF" />
                        <TextBlock Text="{Binding Tester.ControllerName}" FontSize="12.5" Foreground="#8E9BAE" />
                    </StackPanel>
                    <Border Classes="pill" Background="#17402E" IsVisible="{Binding Tester.Connected}">
                        <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="#2EF2A0" VerticalAlignment="Center" /><TextBlock Text="CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#2EF2A0" /></StackPanel>
                    </Border>
                    <Border Classes="pill" Background="#4A3A18" IsVisible="{Binding !Tester.Connected}">
                        <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="#FFAA00" VerticalAlignment="Center" /><TextBlock Text="NO CONTROLLER" FontSize="10" FontWeight="Bold" Foreground="#FFAA00" /></StackPanel>
                    </Border>
                    <Border Classes="pill" Background="#2E2A18" IsVisible="{Binding Tester.IsPaused}">
                        <TextBlock Text="PAUSED" FontSize="10" FontWeight="Bold" Foreground="#E9C46A" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel><TextBlock Text="SESSION" Classes="col" /><TextBlock Text="{Binding Tester.SessionText}" Classes="big" FontSize="20" /></StackPanel>
                    <StackPanel><TextBlock Text="REPORT RATE" Classes="col" /><TextBlock Text="{Binding Tester.RateText}" Classes="big" FontSize="20" /></StackPanel>
                    <StackPanel><TextBlock Text="CHANGES" Classes="col" /><TextBlock Text="{Binding Tester.TotalText}" Classes="big" FontSize="20" /></StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Tester.Notice}" Classes="soft" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="260" />
                    <ToggleButton Content="Pause" Classes="chip" IsChecked="{Binding Tester.IsPaused, Mode=OneWay}" Command="{Binding ToggleTesterPauseCommand}" />
                    <Button Content="Copy report" Classes="chip" Command="{Binding CopyTesterReportCommand}" />
                    <Button Content="Save report" Classes="chip" Command="{Binding SaveTesterReportCommand}" />
                    <Button Content="Reset" Classes="chip" Command="{Binding ResetTesterCommand}" />
                    <Button Name="ExitButton" Content="Close tester  (Esc)" Classes="chip" Background="#E9C46A" Foreground="#14161B" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16" RowDefinitions="*,Auto" ColumnDefinitions="*,1.5*,*">

            <Border Grid.Row="0" Grid.Column="0" Classes="tile" Margin="0,0,12,12" DataContext="{Binding Tester.Left}">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Reset" Classes="chip" Command="{Binding $parent[UserControl].DataContext.ResetTesterLeftStickCommand}" />
                        <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="bar" /><TextBlock Text="LEFT STICK" Classes="h" /></StackPanel>
                    </DockPanel>
                    <t:StickPlot Grid.Row="1" MinHeight="110" Snapshot="{Binding Snapshot}" DeadzoneMin="{Binding DeadzoneMin}" DeadzoneMax="{Binding DeadzoneMax}" />
                    <TextBlock Grid.Row="2" Text="{Binding PositionText}" Classes="big" FontSize="22" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <UniformGrid Grid.Row="3" Columns="2" Margin="0,8,0,0">
                        <StackPanel HorizontalAlignment="Center" ToolTip.Tip="How far the edge the stick reaches is from a perfect circle, on average. Under 10 % is healthy. Roll the stick slowly around its edge, all the way out, to measure it.">
                            <TextBlock Text="CIRCLE ERROR" Classes="col" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding RoundnessText}" Classes="val" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" ToolTip.Tip="How much of the circle the stick has been pushed all the way out to.">
                            <TextBlock Text="COVERAGE" Classes="col" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CoverageText}" Classes="val" HorizontalAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                    <Border Grid.Row="4" Classes="rule" />
                    <ContentControl Grid.Row="5" ContentTemplate="{StaticResource ButtonRows}" Content="{Binding $parent[UserControl].DataContext.Tester.LeftButtons}" />
                </Grid>
            </Border>

            <!-- THE CONTROLLER, and both triggers: pressure and travel -->
            <Border Grid.Row="0" Grid.Column="1" Classes="tile" Margin="0,0,0,12">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6"><Border Classes="bar" /><TextBlock Text="LIVE" Classes="h" /></StackPanel>
                    <Border Grid.Row="1" CornerRadius="10" Padding="0,8" BorderBrush="#222733" BorderThickness="1" Background="#12151B">
                        <art:ArtView MinHeight="120" IsHitTestVisible="False" ShowEditing="False" Scene="{Binding SkinArt}" Sources="{Binding ControllerButtons}" />
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding PressedText}" Classes="mono" HorizontalAlignment="Center" Margin="0,8,0,0" MinHeight="16" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,8"><Border Classes="bar" /><TextBlock Text="TRIGGERS  ·  PRESSURE AND TRAVEL" Classes="h" /></StackPanel>
                    <Grid Grid.Row="4" ColumnDefinitions="*,24,*">
                        <ContentControl ContentTemplate="{StaticResource TriggerPanel}" Content="{Binding Tester.LeftTrigger}" />
                        <ContentControl Grid.Column="2" ContentTemplate="{StaticResource TriggerPanel}" Content="{Binding Tester.RightTrigger}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Classes="tile" Margin="12,0,0,12" DataContext="{Binding Tester.Right}">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Reset" Classes="chip" Command="{Binding $parent[UserControl].DataContext.ResetTesterRightStickCommand}" />
                        <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="bar" /><TextBlock Text="RIGHT STICK" Classes="h" /></StackPanel>
                    </DockPanel>
                    <t:StickPlot Grid.Row="1" MinHeight="110" Snapshot="{Binding Snapshot}" DeadzoneMin="{Binding DeadzoneMin}" DeadzoneMax="{Binding DeadzoneMax}" />
                    <TextBlock Grid.Row="2" Text="{Binding PositionText}" Classes="big" FontSize="22" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <UniformGrid Grid.Row="3" Columns="2" Margin="0,8,0,0">
                        <StackPanel HorizontalAlignment="Center" ToolTip.Tip="How far the edge the stick reaches is from a perfect circle, on average. Under 10 % is healthy. Roll the stick slowly around its edge, all the way out, to measure it.">
                            <TextBlock Text="CIRCLE ERROR" Classes="col" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding RoundnessText}" Classes="val" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" ToolTip.Tip="How much of the circle the stick has been pushed all the way out to.">
                            <TextBlock Text="COVERAGE" Classes="col" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CoverageText}" Classes="val" HorizontalAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                    <Border Grid.Row="4" Classes="rule" />
                    <ContentControl Grid.Row="5" ContentTemplate="{StaticResource ButtonRows}" Content="{Binding $parent[UserControl].DataContext.Tester.RightButtons}" />
                </Grid>
            </Border>

            <!-- VIBRATION -->
            <Border Grid.Row="1" Grid.Column="0" Classes="tile" Margin="0,0,12,0" IsVisible="{Binding CanVibrate}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10"><Border Classes="bar" /><TextBlock Text="VIBRATION TEST" Classes="h" /></StackPanel>
                    <WrapPanel>
                        <Button Content="Left motor" Command="{Binding VibrateLeftCommand}" Classes="chip" Padding="14,7" Margin="0,0,8,8" />
                        <Button Content="Right motor" Command="{Binding VibrateRightCommand}" Classes="chip" Padding="14,7" Margin="0,0,8,8" />
                        <Button Content="Both" Command="{Binding VibrateBothCommand}" Classes="chip" Padding="14,7" Margin="0,0,8,8" />
                        <Button Content="Stop" Command="{Binding StopVibrationCommand}" Classes="chip" Padding="14,7" Margin="0,0,0,8" />
                    </WrapPanel>
                    <ToggleButton Content="Vibrate until stopped" IsChecked="{Binding VibrateContinuously, Mode=TwoWay}" Classes="chip" Padding="14,7" HorizontalAlignment="Left" Margin="0,2,0,10"
                                  ToolTip.Tip="Keep the motors running until you press Stop or switch this off, instead of for under a second." />
                    <TextBlock Text="Otherwise each test shakes for under a second. The left motor is the heavy, low rumble; the right one is the light, fine buzz." Classes="soft" FontSize="11" />
                </StackPanel>
            </Border>

            <!-- GRAPH and TIMING -->
            <Border Grid.Row="1" Grid.Column="1" Classes="tile">
                <Grid ColumnDefinitions="1.7*,22,*">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6"><Border Classes="bar" /><TextBlock Text="LAST 6 SECONDS" Classes="h" /></StackPanel>
                        <WrapPanel Margin="0,0,0,6"><StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,2"><Ellipse Width="9" Height="9" Fill="#E9C46A" /><TextBlock Text="Left X" Classes="soft" FontSize="11" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,2"><Ellipse Width="9" Height="9" Fill="#F4A261" /><TextBlock Text="Left Y" Classes="soft" FontSize="11" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,2"><Ellipse Width="9" Height="9" Fill="#5BC0EB" /><TextBlock Text="Right X" Classes="soft" FontSize="11" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,2"><Ellipse Width="9" Height="9" Fill="#9B8CFF" /><TextBlock Text="Right Y" Classes="soft" FontSize="11" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,2"><Ellipse Width="9" Height="9" Fill="#00E676" /><TextBlock Text="Left trigger" Classes="soft" FontSize="11" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,2"><Ellipse Width="9" Height="9" Fill="#FF6B6B" /><TextBlock Text="Right trigger" Classes="soft" FontSize="11" /></StackPanel></WrapPanel>
                        <t:ScopeGraph Height="104" Series="{Binding Tester.Scope}" Channels="0,1,2,3" Minimum="-1" Maximum="1" ToolTip.Tip="Sticks, from −1 to +1" />
                        <t:ScopeGraph Height="56" Margin="0,6,0,0" Series="{Binding Tester.Scope}" Channels="4,5" Minimum="0" Maximum="1" ToolTip.Tip="Triggers, from 0 to 1" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" MinWidth="200">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6"><Border Classes="bar" /><TextBlock Text="TIMING" Classes="h" /></StackPanel>
                        <TextBlock Text="CHANGES PER SECOND" Classes="col" />
                        <TextBlock Text="{Binding Tester.RateNumberText}" Classes="big" FontSize="26" Foreground="{StaticResource BrushCyan}" />
                        <TextBlock Text="{Binding Tester.JitterText}" Classes="mono" FontSize="11" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Tester.IntervalText}" Classes="mono" FontSize="11" />
                        <t:Histogram Height="62" Margin="0,8,0,0" Values="{Binding Tester.Histogram}" StartLabel="0 ms" EndLabel="40+ ms" BarColor="#E9C46A"
                                     ToolTip.Tip="Gaps between reports. Move a stick steadily: a tall, narrow spike means an even report rate; a spread or a bar far to the right means lag or dropped reports (Bluetooth is usually 60 – 250 a second, wired up to 1000)." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- REACTION -->
            <Border Grid.Row="1" Grid.Column="2" Classes="tile" Margin="12,0,0,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10"><Border Classes="bar" /><TextBlock Text="REACTION TEST" Classes="h" /></StackPanel>
                    <Button Grid.Row="1" Classes="react" Classes.wait="{Binding Tester.ReactionWait}" Classes.go="{Binding Tester.ReactionGo}" Classes.bad="{Binding Tester.ReactionBad}" Classes.done="{Binding Tester.ReactionDone}"
                            Command="{Binding StartReactionTestCommand}" ToolTip.Tip="Includes up to one screen refresh (about 17 ms) before you see the signal.">
                        <TextBlock Text="{Binding Tester.ReactionText}" Classes="big" FontSize="26" TextAlignment="Center" TextWrapping="Wrap" />
                    </Button>
                    <TextBlock Grid.Row="2" Text="{Binding Tester.ReactionDetail}" Classes="soft" FontSize="11.5" Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
