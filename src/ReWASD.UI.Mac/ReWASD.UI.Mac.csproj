<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ReWASD</AssemblyName>
    <RootNamespace>ReWASD.UI.Mac</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest></ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.png" />
    <AvaloniaResource Include="Assets\tray.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReWASD.UI.Mac.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReWASD.Core\ReWASD.Core.csproj" />
    <ProjectReference Include="..\ReWASD.Engine\ReWASD.Engine.csproj" />
    <ProjectReference Include="..\ReWASD.App\ReWASD.App.csproj" />
  </ItemGroup>

</Project>
