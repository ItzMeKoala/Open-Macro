<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ReWASD.UI.Mac.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="ReWASD.UI.Mac.MainWindow"
        Title="ReWASD Open Source — Gamepad Remapper"
        Width="1200" Height="720" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Rows of the controller-picture and config lists -->
        <DataTemplate x:Key="ProfileItemTemplate">
            <StackPanel Margin="2,4">
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ProcessExecutable, TargetNullValue='All applications'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="48,44,38,*,46,58">

        <!-- 1. CONFIG BAR -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Name="ConfigToggle" Classes="bare" IsChecked="{Binding IsConfigMenuOpen, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedProfile.Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <PathIcon Data="{StaticResource IconChevronDown}" Width="11" Height="11" Foreground="{StaticResource BrushTextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Button Classes="icon" Margin="10,0,0,0" ToolTip.Tip="Save config" Command="{Binding SaveProfileCommand}">
                        <PathIcon Data="{StaticResource IconSave}" Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon" ToolTip.Tip="About" Command="{Binding ShowInfoCommand}">
                        <PathIcon Data="{StaticResource IconInfo}" Width="16" Height="16" />
                    </Button>

                    <!-- Config switcher -->
                    <Popup IsOpen="{Binding IsConfigMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding #ConfigToggle}"
                           Placement="Bottom" IsLightDismissEnabled="True" WindowManagerAddShadowHint="False">
                        <Border Classes="menu" Width="300" Margin="0,4,0,0" Padding="10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="CONFIGS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Classes="icon" Width="28" Height="28" ToolTip.Tip="New config" Command="{Binding NewProfileCommand}">
                                        <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
                                    </Button>
                                </DockPanel>
                                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                         ItemTemplate="{StaticResource ProfileItemTemplate}" MaxHeight="220"
                                         Background="Transparent" BorderThickness="0" />
                                <TextBlock Text="Target process (blank = all)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,10,0,4" />
                                <TextBox Text="{Binding SelectedProcessExecutable}" Padding="8,6" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="icon" ToolTip.Tip="Preferences" Command="{Binding ToggleSettingsCommand}">
                        <PathIcon Data="{StaticResource IconSettings}" Width="17" Height="17" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. LAYER BAR -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgPanel}" Padding="14,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding LayerNames}" SelectedIndex="{Binding ActiveShiftLayer, Mode=TwoWay}"
                          Width="150" Background="Transparent" BorderThickness="0" FontSize="14" />
                <!-- How this layer is reached: which buttons, and hold vs toggle -->
                <ToggleButton Name="LayerToggle" Classes="icon" Width="34" Height="34" Margin="4,0,0,0"
                              ToolTip.Tip="Layer activation (buttons and hold/toggle)"
                              IsEnabled="{Binding IsLayerEditable}"
                              IsChecked="{Binding IsLayerMenuOpen, Mode=TwoWay}">
                    <PathIcon Data="{StaticResource IconSettings}" Width="15" Height="15" />
                </ToggleButton>
                <Popup IsOpen="{Binding IsLayerMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding #LayerToggle}"
                       Placement="Bottom" IsLightDismissEnabled="True" WindowManagerAddShadowHint="False">
                    <Border Classes="menu" Width="300" Margin="0,4,0,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="ACTIVATE THIS LAYER WITH" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="Pick up to 4 buttons; all must be held together." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding LayerModifierOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Width="136" Margin="0,0,0,6"
                                                  Foreground="{StaticResource BrushTextPrimary}" FontSize="12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="BEHAVIOUR" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,10,0,6" />
                            <ComboBox ItemsSource="{Binding AvailableLayerTypes}" SelectedItem="{Binding SelectedLayerType}" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Hold: active while held. Toggle: each press switches it on or off." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Border>

        <!-- 3. INPUT-TYPE TABS -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgPanel}" Padding="14,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <RadioButton Classes="tab" Margin="0,0,10,0" HorizontalAlignment="Center"
                             IsChecked="{Binding SelectedInputTab, Converter={StaticResource EnumToBool}, ConverterParameter=Gamepad}">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{StaticResource IconGamepad}" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Gamepad" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Classes="tab" Margin="0,0,10,0" HorizontalAlignment="Center"
                             ToolTip.Tip="Remap keyboard keys (the original key is swallowed while remapping is on)"
                             IsChecked="{Binding SelectedInputTab, Converter={StaticResource EnumToBool}, ConverterParameter=Keyboard}">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{StaticResource IconKeyboard}" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Keyboard" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Classes="tab" HorizontalAlignment="Center"
                             ToolTip.Tip="Remap mouse buttons and the wheel (the original is swallowed while remapping is on)"
                             IsChecked="{Binding SelectedInputTab, Converter={StaticResource EnumToBool}, ConverterParameter=Mouse}">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{StaticResource IconMouse}" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Mouse" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 4. CONTENT: visualizer | inspector -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">

            <!-- The controller, keyboard or mouse drawing -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgDeep}" MinWidth="420">
                <views:InputSurface />
            </Border>

            <!-- Inspector -->
            <Border Grid.Column="1" Width="340">
                <views:MappingPanel />
            </Border>

            <!-- Preferences page: covers the visualizer and inspector -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource BrushBgDeep}" Padding="32" IsVisible="{Binding IsPreferencesPage}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="Preferences" Foreground="{StaticResource BrushTextPrimary}" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" />

                        <!-- Windows: the two optional drivers -->
                        <StackPanel IsVisible="{Binding !IsMacOS}">
                            <TextBlock Text="DRIVERS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Text="{Binding DriverStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="Required to present a virtual Xbox 360 controller to games." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,10" />
                                    <TextBlock Text="{Binding HidHideStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="Optional. Hides the physical controller so games only see the virtual one (the eye button next to the slot box)." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding HideStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    <Button Content="Show HidHide diagnostics" Command="{Binding ShowHidHideDiagnosticsCommand}" Classes="secondary"
                                            HorizontalAlignment="Left" Padding="12,5" Margin="0,8,0,0" ToolTip.Tip="Prints what HidHide has configured in the status bar" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- macOS: the permissions it asks for, and what it cannot do -->
                        <StackPanel IsVisible="{Binding IsMacOS}">
                            <TextBlock Text="PERMISSIONS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Text="{Binding PermissionStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="macOS only lets an app watch the keyboard and mouse, and press keys for you, once you allow it. Turn on Accessibility and Input Monitoring for this app in System Settings → Privacy &amp; Security, then restart it."
                                               Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding MissingPermissions}" Foreground="{StaticResource BrushOrange}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                               IsVisible="{Binding HasPermissionIssue}" />
                                    <Button Content="Allow access…" Command="{Binding RequestPermissionsCommand}" Classes="secondary"
                                            HorizontalAlignment="Left" Padding="12,5" Margin="0,8,0,0" ToolTip.Tip="Shows the macOS permission prompts" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ON THIS MAC" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Text="Works: controller buttons, sticks and triggers to keyboard keys, mouse buttons, scrolling, layers and macros; keyboard and mouse remapping; macro recording."
                                               Foreground="{StaticResource BrushTextPrimary}" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="Not on macOS: a virtual Xbox or DualShock controller (there is no driver for it), hiding the physical controller from other apps, and vibration."
                                               Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="ACTIVATOR TIMING (this config)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                        <Border Classes="card">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LongPressMs, StringFormat='{}{0} ms'}" Foreground="{StaticResource BrushCyan}" FontSize="12" />
                                    <TextBlock Text="Long press after" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                </DockPanel>
                                <Slider Minimum="150" Maximum="1500" SmallChange="10" LargeChange="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LongPressMs}" Margin="0,4,0,12" />

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MultiPressWindowMs, StringFormat='{}{0} ms'}" Foreground="{StaticResource BrushCyan}" FontSize="12" />
                                    <TextBlock Text="Double / triple press window" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                </DockPanel>
                                <Slider Minimum="80" Maximum="800" SmallChange="10" LargeChange="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MultiPressWindowMs}" Margin="0,4,0,12" />

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PulseMs, StringFormat='{}{0} ms'}" Foreground="{StaticResource BrushCyan}" FontSize="12" />
                                    <TextBlock Text="One-time pulse length" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                </DockPanel>
                                <Slider Minimum="10" Maximum="300" SmallChange="5" LargeChange="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PulseMs}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SAFETY" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                        <Border Classes="card">
                            <StackPanel>
                                <TextBlock Text="{Binding PanicKeyText, StringFormat='Panic key: {0}'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                <TextBlock Text="Stops remapping immediately and gives every key and mouse button back, even if a mapping has taken over something you need." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel IsVisible="{Binding SupportsVirtualController}">
                            <TextBlock Text="OUTPUT" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Text="Virtual controller: Xbox 360" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="Other output types are not implemented yet." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 5. DEVICE BAR -->
        <Border Grid.Row="4" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconGamepad}" Width="20" Height="20" Foreground="{StaticResource BrushCyan}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConnectedDevices[0]}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DriverStatusText}" Classes="status" Classes.ok="{Binding IsDriverAvailable}" IsVisible="{Binding !IsMacOS}" />
                    <TextBlock Text="{Binding HidHideStatusText}" Classes="status" Classes.ok="{Binding IsHidHideAvailable}" IsVisible="{Binding !IsMacOS}" />
                    <TextBlock Text="{Binding PermissionStatusText}" Classes="status" Classes.ok="{Binding !HasPermissionIssue}" IsVisible="{Binding IsMacOS}" />
                    <TextBlock Text="{Binding BuildText}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 6. APPLY BAR -->
        <Border Grid.Row="5" Background="{StaticResource BrushBgDeep}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid ColumnDefinitions="Auto,*">

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Start / stop remapping -->
                    <Button Command="{Binding ToggleApplyCommand}" Classes="apply" MinWidth="150" Height="42">
                        <TextBlock FontWeight="Bold" FontSize="14" Text="APPLY" Classes.stop="{Binding IsRemappingActive}">
                            <TextBlock.Styles>
                                <Style Selector="TextBlock.stop">
                                    <Setter Property="Text" Value="STOP" />
                                </Style>
                            </TextBlock.Styles>
                        </TextBlock>
                    </Button>

                    <!-- Slot -->
                    <ComboBox ItemsSource="{Binding SlotNumbers}" SelectedItem="{Binding ActiveSlot, Mode=TwoWay}"
                              Width="96" Height="42" FontSize="15" FontWeight="SemiBold" Margin="8,0,14,0" VerticalAlignment="Center"
                              ToolTip.Tip="Slot" />

                    <!-- Virtual controller: which controller games will see (Windows only: macOS has no virtual controller) -->
                    <ToggleButton Name="OutputToggle" Classes="icon" Width="46" Height="42" Margin="0,0,6,0"
                                  ToolTip.Tip="Virtual controller: what games will see"
                                  IsVisible="{Binding SupportsVirtualController}"
                                  IsChecked="{Binding IsOutputMenuOpen, Mode=TwoWay}">
                        <PathIcon Data="{StaticResource IconGamepad}" Width="20" Height="20" />
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsOutputMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding #OutputToggle}" Placement="Top"
                           HorizontalOffset="-10" VerticalOffset="-6" IsLightDismissEnabled="True" WindowManagerAddShadowHint="False">
                        <Border Classes="menu" Width="340" Padding="10">
                            <StackPanel>
                                <TextBlock Text="VIRTUAL CONTROLLER" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="4,2,0,8" />
                                <ListBox ItemsSource="{Binding VirtualControllerOptions}" SelectedValueBinding="{Binding Type}"
                                         SelectedValue="{Binding SelectedVirtualController, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="14" Margin="4,3" Foreground="{StaticResource BrushTextPrimary}"
                                                       Opacity="{Binding IsAvailable, Converter={x:Static BoolConverters.Not}}"
                                                       ToolTip.Tip="{Binding Note}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Hide the original controller from games (HidHide, Windows only) -->
                    <ToggleButton Classes="icon" Width="46" Height="42" IsVisible="{Binding SupportsDeviceHiding}"
                                  IsChecked="{Binding HideInputDevice, Mode=TwoWay}" IsEnabled="{Binding IsHidHideAvailable}">
                        <PathIcon Data="{StaticResource IconEyeOff}" Width="20" Height="20" />
                        <ToolTip.Tip>
                            <StackPanel>
                                <TextBlock Text="Hide the original controller from games" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HideStatusText}" Foreground="#999999" />
                            </StackPanel>
                        </ToolTip.Tip>
                    </ToggleButton>

                    <!-- macOS: shown while a permission is missing -->
                    <Button Content="Allow access…" Command="{Binding RequestPermissionsCommand}" Classes="secondary" Height="42" Margin="14,0,0,0"
                            IsVisible="{Binding HasPermissionIssue}" ToolTip.Tip="{Binding MissingPermissions}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="14,0,0,0" />
            </Grid>
        </Border>

    </Grid>
</Window>
