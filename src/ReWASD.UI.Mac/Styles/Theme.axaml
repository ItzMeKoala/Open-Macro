<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Open-Macro palette: the same values as the Windows front end. Neutral charcoal surfaces in a few close tones, one gold accent. -->
        <Color x:Key="ColorBgDeep">#0D0F12</Color>
        <Color x:Key="ColorBgNav">#101215</Color>
        <Color x:Key="ColorBgPanel">#111316</Color>
        <Color x:Key="ColorBgInset">#17191D</Color>
        <Color x:Key="ColorBgCard">#1D2024</Color>
        <Color x:Key="ColorBgControl">#292C31</Color>
        <Color x:Key="ColorBgCardHover">#35383E</Color>
        <Color x:Key="ColorBgSelected">#3D3F44</Color>
        <Color x:Key="ColorBorder">#2A2D33</Color>
        <Color x:Key="ColorBorderLight">#454A53</Color>
        <Color x:Key="ColorPrimary">#FFFFFF</Color>
        <Color x:Key="ColorOnPrimary">#20242C</Color>
        <Color x:Key="ColorFocus">#ADB8FF</Color>

        <!-- Accents: the "Cyan" keys are kept so both front ends share names; the accent is the warm gold -->
        <Color x:Key="ColorCyan">#E9C46A</Color>
        <Color x:Key="ColorCyanHover">#F2D68F</Color>
        <Color x:Key="ColorCyanDark">#A8873A</Color>
        <Color x:Key="ColorOrange">#FFAA00</Color>
        <Color x:Key="ColorGreen">#00E676</Color>
        <Color x:Key="ColorYellow">#FFCC00</Color>

        <Color x:Key="ColorTextPrimary">#F4F5F7</Color>
        <Color x:Key="ColorTextSecondary">#B8BCC5</Color>
        <Color x:Key="ColorTextMuted">#969DA9</Color>

        <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource ColorBgDeep}" />
        <SolidColorBrush x:Key="BrushBgNav" Color="{StaticResource ColorBgNav}" />
        <SolidColorBrush x:Key="BrushBgPanel" Color="{StaticResource ColorBgPanel}" />
        <SolidColorBrush x:Key="BrushBgInset" Color="{StaticResource ColorBgInset}" />
        <SolidColorBrush x:Key="BrushBgControl" Color="{StaticResource ColorBgControl}" />
        <SolidColorBrush x:Key="BrushBgSelected" Color="{StaticResource ColorBgSelected}" />
        <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
        <SolidColorBrush x:Key="BrushOnPrimary" Color="{StaticResource ColorOnPrimary}" />
        <SolidColorBrush x:Key="BrushFocus" Color="{StaticResource ColorFocus}" />
        <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}" />
        <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}" />
        <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
        <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource ColorBorderLight}" />
        <SolidColorBrush x:Key="BrushCyan" Color="{StaticResource ColorCyan}" />
        <SolidColorBrush x:Key="BrushCyanHover" Color="{StaticResource ColorCyanHover}" />
        <SolidColorBrush x:Key="BrushCyanDark" Color="{StaticResource ColorCyanDark}" />
        <SolidColorBrush x:Key="BrushOrange" Color="{StaticResource ColorOrange}" />
        <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource ColorGreen}" />
        <SolidColorBrush x:Key="BrushYellow" Color="{StaticResource ColorYellow}" />
        <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
        <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

        <!-- Make the stock Fluent controls follow the palette (gold accent, dark cards) -->
        <Color x:Key="SystemAccentColor">#E9C46A</Color>
        <Color x:Key="SystemAccentColorDark1">#D1AB52</Color>
        <Color x:Key="SystemAccentColorDark2">#A8873A</Color>
        <Color x:Key="SystemAccentColorDark3">#7F6628</Color>
        <Color x:Key="SystemAccentColorLight1">#F2D68F</Color>
        <Color x:Key="SystemAccentColorLight2">#F7E3B0</Color>
        <Color x:Key="SystemAccentColorLight3">#FBEFCF</Color>

        <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource ColorBgControl}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource ColorBgCardHover}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource ColorBgPanel}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource ColorBgControl}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{StaticResource ColorBgControl}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource ColorBorder}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource ColorBorderLight}" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource ColorBgPanel}" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource ColorBorderLight}" />
        <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource ColorBgControl}" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource ColorBgControl}" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource ColorBgControl}" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource ColorBorder}" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource ColorBorderLight}" />
        <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="{StaticResource ColorBgCardHover}" />
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="{StaticResource ColorBgSelected}" />
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="{StaticResource ColorBgCardHover}" />
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="{StaticResource ColorBgSelected}" />
        <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="{StaticResource ColorBgCardHover}" />
    </Styles.Resources>

    <!-- Window and text -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BrushBgDeep}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style Selector="TextBlock.section">
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>

    <Style Selector="TextBlock.status">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource BrushOrange}" />
    </Style>
    <Style Selector="TextBlock.status.ok">
        <Setter Property="Foreground" Value="{StaticResource BrushGreen}" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource BrushBgCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- Buttons -->
    <!-- Flat icon button -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource BrushBgCardHover}" />
    </Style>
    <Style Selector="Button.icon:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- Flat icon toggle: gold when checked -->
    <Style Selector="ToggleButton.icon">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.icon:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource BrushBgCardHover}" />
    </Style>
    <Style Selector="ToggleButton.icon:checked">
        <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
    </Style>
    <Style Selector="ToggleButton.icon:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- The slot half of the Start split button: a dark rounded segment tucked behind the Start pill -->
    <Style Selector="ToggleButton.slot">
        <Setter Property="Background" Value="#33363C" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.slot:pointerover /template/ Border#Bd"><Setter Property="Background" Value="#41454C" /></Style>
    <Style Selector="ToggleButton.slot:checked /template/ Border#Bd"><Setter Property="Background" Value="#41454C" /></Style>

    <!-- A toggle that shows only its content (the config name in the top bar) -->
    <Style Selector="ToggleButton.bare">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- START / STOP: the one white action of the page; while remapping it becomes a quiet Stop beside a green square -->
    <Style Selector="Button.apply">
        <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
        <Setter Property="Foreground" Value="{StaticResource BrushOnPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                        BorderThickness="2" BorderBrush="Transparent">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.apply:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="#E6E8EC" />
    </Style>
    <Style Selector="Button.apply:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="#CDD0D6" />
    </Style>
    <Style Selector="Button.apply:focus-visible /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{StaticResource BrushFocus}" />
    </Style>
    <Style Selector="Button.apply.on">
        <Setter Property="Background" Value="{StaticResource BrushBgControl}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style Selector="Button.apply.on:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource BrushBgCardHover}" />
    </Style>

    <!-- A round utility button in the header -->
    <Style Selector="Button.circle, ToggleButton.circle">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Background" Value="{StaticResource BrushBgControl}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="20" BorderThickness="2" BorderBrush="Transparent">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.circle:pointerover /template/ Border#Bd, ToggleButton.circle:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource BrushBgCardHover}" />
    </Style>
    <Style Selector="Button.circle:pointerover, ToggleButton.circle:pointerover, ToggleButton.circle:checked">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style Selector="Button.circle:focus-visible /template/ Border#Bd, ToggleButton.circle:focus-visible /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{StaticResource BrushFocus}" />
    </Style>
    <Style Selector="Button.circle:disabled, ToggleButton.circle:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- A rounded work panel, and the band across its top -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.panelhead">
        <Setter Property="Background" Value="{StaticResource BrushBgInset}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- Navigation rows in the rail: a filled gray row for the current one -->
    <Style Selector="RadioButton.rail">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.rail:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>
    <Style Selector="RadioButton.rail:checked">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style Selector="RadioButton.rail:checked /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource BrushBgSelected}" />
    </Style>
    <Style Selector="RadioButton.rail:checked PathIcon">
        <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
    </Style>
    <Style Selector="RadioButton.rail:focus-visible /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{StaticResource BrushFocus}" />
    </Style>

    <!-- A full-width row button inside a rail group -->
    <Style Selector="ToggleButton.row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="Stretch" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.row:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>
    <Style Selector="ToggleButton.row:focus-visible /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{StaticResource BrushFocus}" />
    </Style>

    <!-- The list of configs in the rail -->
    <Style Selector="ListBox.rail">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.rail ListBoxItem">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.rail ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgSelected}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.rail ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgSelected}" />
    </Style>
    <Style Selector="ListBox.rail ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>

    <!-- Labelled buttons in the top bar -->
    <Style Selector="Button.bar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.bar:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="#18FFFFFF" />
    </Style>
    <Style Selector="Button.bar:pointerover">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- SAVE (the gold call to action in the inspector) -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource BrushCyan}" />
        <Setter Property="Foreground" Value="#101318" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="0,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.primary:disabled /template/ Border#Bd">
        <Setter Property="Background" Value="#26262A" />
    </Style>
    <Style Selector="Button.primary:disabled">
        <Setter Property="Foreground" Value="#6B7587" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource BrushCyanHover}" />
    </Style>

    <!-- Ghost / secondary button -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{StaticResource BrushBgCard}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource BrushBgCardHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushCyan}" />
    </Style>
    <Style Selector="Button.secondary:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
    </Style>

    <!-- Tab-like radio button -->
    <Style Selector="RadioButton.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.tab:pointerover">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style Selector="RadioButton.tab:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="#15FFFFFF" />
    </Style>
    <Style Selector="RadioButton.tab:checked">
        <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
    </Style>
    <Style Selector="RadioButton.tab:checked /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{StaticResource BrushCyan}" />
    </Style>

    <!-- Segmented switch in a well: Gamepad / Keyboard / Mouse -->
    <Style Selector="Border.segbox">
        <Setter Property="Background" Value="#141416" />
        <Setter Property="BorderBrush" Value="#2E2E33" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="RadioButton.pill">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.pill:pointerover">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style Selector="RadioButton.pill:checked">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style Selector="RadioButton.pill:checked /template/ Border#Bd">
        <Setter Property="Background" Value="#2E2E34" />
    </Style>
    <Style Selector="RadioButton.pill:checked PathIcon">
        <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
    </Style>

    <!-- Small label above a field in the inspector -->
    <Style Selector="TextBlock.field">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>

    <!-- Segmented choices: the selected one is outlined in gold -->
    <Style Selector="Button.seg, RadioButton.seg">
        <Setter Property="Background" Value="#232328" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="6,8" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#34343A" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.seg:pointerover /template/ Border#Bd, RadioButton.seg:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="#2C2C33" />
    </Style>
    <Style Selector="Button.seg.sel, RadioButton.seg:checked">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style Selector="Button.seg.sel /template/ Border#Bd, RadioButton.seg:checked /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{StaticResource BrushCyan}" />
        <Setter Property="Background" Value="#2A2412" />
    </Style>

    <!-- Quiet text button (Reset) -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="#18FFFFFF" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- A list of sections down the side of a page -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" BorderThickness="3,0,0,0" BorderBrush="Transparent"
                        CornerRadius="0,6,6,0" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="#14FFFFFF" />
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#Bd">
        <Setter Property="BorderBrush" Value="{StaticResource BrushCyan}" />
        <Setter Property="Background" Value="#1AE9C46A" />
    </Style>

    <!-- Lists and inputs -->
    <Style Selector="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgCardHover}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushCyan}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgCardHover}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style Selector="Popup > Border.menu">
        <Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderLight}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
</Styles>
