                                    </ItemsControl>
                                    <TextBlock Text="Slice name, e.g. Browser" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,6,0,2" />
                                    <TextBox Text="{Binding NewWheelLabel, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                    <TextBlock Text="Action, e.g. LaunchApp:Chrome" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,6,0,2" />
                                    <TextBox Text="{Binding NewWheelAction, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                    <Button Content="Add slice" Command="{Binding AddWheelItemCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding WheelMessage}" Foreground="{StaticResource BrushOrange}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SettingsSection}" Value="Configs"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="SAVING" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <CheckBox Content="Save configs automatically" IsChecked="{Binding AutoSaveProfiles}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="A config is written a moment after you change it, and when you switch config or close the app. Older copies are kept under History." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding SaveStateText, StringFormat='This config: {0}'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="PROFILES AND LOCK" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <CheckBox Content="Switch profile to match the app in front" IsChecked="{Binding AutoSwitchProfiles}" IsEnabled="{Binding CanAutoSwitch, Mode=OneTime}"
                                              Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="Give a profile a target app (the box under the profile list, e.g. game.exe) and it takes over while that app is in front." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,12" />

                                    <TextBlock Text="Lock the controller by holding" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.LockChordNames}" SelectedIndex="{Binding LockChordIndex}" />
                                    <TextBlock Text="Hold them for a second to lock; again to unlock. While locked the controller does nothing." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
                                    <ToggleButton Content="Controller locked" IsChecked="{Binding IsControllerLocked, Mode=OneWay}" Command="{Binding ToggleLockCommand}" HorizontalAlignment="Left" Padding="12,5" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="HISTORY" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding HistoryHint}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding HistoryEntries}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Button DockPanel.Dock="Right" Content="Restore" Style="{StaticResource SecondaryButtonStyle}" Padding="10,3" FontSize="11"
                                                            Command="{Binding DataContext.RestoreHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SettingsSection}" Value="Integrations"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="OBS STUDIO (for Obs: macro steps)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="In OBS: Tools, then WebSocket Server Settings, then Enable. Kept on this computer only." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ObsHost, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" Padding="6,4" />
                                        <TextBox Grid.Column="1" Text="{Binding ObsPort, UpdateSourceTrigger=LostFocus}" Padding="6,4" />
                                    </Grid>
                                    <TextBlock Text="Password (if you set one)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,8,0,2" />
                                    <TextBox x:Name="ObsPasswordBox" Padding="6,4" Text="{Binding ObsPassword, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SettingsSection}" Value="Window"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="OVERLAY (for streams)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <ToggleButton Content="Show the controller overlay" IsChecked="{Binding ShowOverlay}" HorizontalAlignment="Left" Padding="12,5" />
                                    <TextBlock Text="A small window that stays on top and shows your controller moving. Drag it where you want it and resize it from its corner; capture it with a window capture in OBS. Turn it off here." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="BACKGROUND" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <CheckBox Content="Keep running when the window is closed" IsChecked="{Binding KeepRunningInBackground}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="The close button hides the window and Open-Macro stays in the notification area (next to the clock); use its icon to open the window or quit." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SettingsSection}" Value="System"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="DRIVERS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding DriverStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="Required to present a virtual Xbox 360 controller to games." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,10" />
                                    <TextBlock Text="{Binding HidHideStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="Optional. Hides the physical controller so games only see the virtual one (the toggle switch in the bottom bar)." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding HideStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    <Button Content="Show HidHide diagnostics" Command="{Binding ShowHidHideDiagnosticsCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Left" Padding="12,5" Margin="0,8,0,0" ToolTip="Prints what HidHide has configured in the status bar" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="UPDATES" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding BuildText, StringFormat='This build: {0}'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Check now" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" />
                                        <Button Content="Update now" Command="{Binding InstallUpdateCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" Margin="8,0,0,0"
                                                Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding UpdateProgress, Mode=OneWay}" Height="6" Margin="0,10,0,0"
                                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                                    <CheckBox Content="Check for updates when Open-Macro starts" IsChecked="{Binding AutoCheckUpdates}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="SAFETY" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Panic key: Ctrl + Alt + Shift + F12" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="Stops remapping immediately and gives every key and mouse button back, even if a mapping has taken over something you need." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="OUTPUT" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Virtual controller: Xbox 360" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="Other output types are not implemented yet." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="USAGE (this computer only)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding UsageSummary}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding TopButtonLines}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource BrushCyan}" FontSize="12" FontFamily="Consolas" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Counted only on this computer; nothing is ever sent anywhere." Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,8,0,0" />
                                    <Button Content="Reset counts" Command="{Binding ResetUsageCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="KEYBOARD SHORTCUTS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding ModifierKeyName, StringFormat='{}{0} + S'}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,16,6" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Save this config now" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                                    <TextBlock Grid.Row="1" Text="{Binding ModifierKeyName, StringFormat='{}{0} + ,'}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,16,6" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Open or close settings" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                                    <TextBlock Grid.Row="2" Text="{Binding ModifierKeyName, StringFormat='{}{0} + Enter'}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,16,6" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Start or stop remapping" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                                    <TextBlock Grid.Row="3" Text="F11" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,16,6" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Open or close the controller tester" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                                    <TextBlock Grid.Row="4" Text="Esc" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,16,6" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Leave settings, the tester or full screen" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>

        <!-- The full-screen tester, created only while it is open -->
        <ContentControl x:Name="TesterHost" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="100" />
    </Grid>
</Window>
