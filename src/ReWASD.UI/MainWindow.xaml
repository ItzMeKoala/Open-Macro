<Window x:Class="ReWASD.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ReWASD.UI.ViewModels;assembly=ReWASD.App"
        xmlns:views="clr-namespace:ReWASD.UI.Views"
        xmlns:conv="clr-namespace:ReWASD.UI.Converters"
        mc:Ignorable="d"
        Title="Open-Macro — Gamepad Remapper"
        Icon="pack://application:,,,/Assets/ReWASD.ico"
        Height="800" Width="1280"
        MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Status indicator: orange by default, green when the dependency is present -->
        <Style x:Key="StatusIndicator" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource BrushOrange}" />
        </Style>

        <!-- Dark selection/hover look for the config list -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgCardHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgCard}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushCyan}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProfileItemTemplate">
            <StackPanel Margin="2,4">
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ProcessExecutable, TargetNullValue='All applications'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- One row of the output-device popup -->
        <Style x:Key="OutputRow" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />   <!-- top bar -->
            <RowDefinition Height="*" />    <!-- rail and workspace -->
        </Grid.RowDefinitions>

        <!-- TOP BAR: the name on the left; what needs attention and the two other pages on the right -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgDeep}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="24,0,12,0">
            <Grid>
                <TextBlock Text="Open-Macro" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Update available" Command="{Binding InstallUpdateCommand}" Style="{StaticResource BarButtonStyle}"
                            Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding UpdateStatusText}"  Margin="0,0,4,0" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding UpdateProgress, Mode=OneWay}" Width="120" Height="8" VerticalAlignment="Center"
                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}"  Margin="0,0,4,0" />
                    <Button x:Name="TesterButton" Style="{StaticResource BarButtonStyle}" VerticalAlignment="Center" Command="{Binding OpenTesterCommand}"
                            ToolTip="Test your controller full screen (F11)" AutomationProperties.Name="Controller tester">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTester}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Tester" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BarButtonStyle}" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="Settings" AutomationProperties.Name="Settings"
                            Command="{Binding ToggleSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY: the rail on the left, the workspace beside it -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- RAIL: what to remap, and the configs -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <RadioButton Style="{StaticResource RailRadioStyle}" GroupName="InputTab" Margin="0,0,0,2" AutomationProperties.Name="Gamepad"
                                     IsChecked="{Binding SelectedInputTab, Converter={StaticResource EnumToBool}, ConverterParameter=Gamepad}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Gamepad" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RailRadioStyle}" GroupName="InputTab" Margin="0,0,0,2" AutomationProperties.Name="Keyboard"
                                     ToolTip="Remap keyboard keys (the original key is swallowed while remapping is on)"
                                     IsChecked="{Binding SelectedInputTab, Converter={StaticResource EnumToBool}, ConverterParameter=Keyboard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Keyboard" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RailRadioStyle}" GroupName="InputTab" AutomationProperties.Name="Mouse"
                                     ToolTip="Remap mouse buttons and the wheel (the original is swallowed while remapping is on)"
                                     IsChecked="{Binding SelectedInputTab, Converter={StaticResource EnumToBool}, ConverterParameter=Mouse}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE962;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Mouse" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <DockPanel Grid.Row="1" Height="36" Margin="12,24,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Configs" Foreground="{StaticResource BrushTextMuted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ToggleButton DockPanel.Dock="Right" x:Name="ConfigToggle" Style="{StaticResource CircleToggleStyle}" Content="&#xE712;"
                                      ToolTip="Config options: use only in one app, presets, import, export, delete" AutomationProperties.Name="Config options"
                                      IsChecked="{Binding IsConfigMenuOpen, Mode=TwoWay}"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=ConfigPopup, Converter={StaticResource InverseBool}}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource CircleButtonStyle}" Content="&#xE710;" ToolTip="New empty config"
                                AutomationProperties.Name="New empty config" Command="{Binding NewProfileCommand}" />
                    <Popup x:Name="ConfigPopup" IsOpen="{Binding IsConfigMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ConfigToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="300" Margin="0,4,0,0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="YOUR CONFIGS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" Width="28" Height="28" ToolTip="New empty config" AutomationProperties.Name="New empty config" Command="{Binding NewProfileCommand}" />
                                </DockPanel>
                                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                         ItemTemplate="{StaticResource ProfileItemTemplate}" MaxHeight="220"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextPrimary}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                <TextBlock Text="USE ONLY IN ONE APP" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,12,0,4" />
                                <TextBox Text="{Binding SelectedProcessExecutable, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushTextPrimary}"
                                         BorderBrush="{StaticResource BrushBorder}" Padding="8,6"
                                         ToolTip="While this app is in front, this config takes over. Leave empty to use it everywhere. For example: game.exe" />
                                <TextBlock Text="Empty means every app. Or type one, like game.exe" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,3,0,0" />
                                <TextBlock Text="NEW FROM A PRESET" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,14,0,6" />
                                <ItemsControl ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}" ToolTip="{Binding Description}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,0,4" HorizontalContentAlignment="Left"
                                                    Command="{Binding DataContext.NewFromPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,10" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Delete config" Command="{Binding DeleteProfileCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Foreground="#FF8A80"
                                            ToolTip="Delete this config. A copy stays under History in Settings." />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Import…" Command="{Binding ImportProfileCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,0" ToolTip="Open a config file someone sent you" />
                                        <Button Content="Export…" Command="{Binding ExportProfileCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" ToolTip="Save this config to a file to share it" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                    </DockPanel>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="Configs"
                             ItemContainerStyle="{StaticResource RailListItemStyle}" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3">
                        <!-- What games see (Windows): the virtual controller and hiding the real one -->
                        <StackPanel Visibility="{Binding SupportsVirtualController, Converter={StaticResource BoolToVisibility}}">
                            <ToggleButton x:Name="OutputToggle" Style="{StaticResource RowToggleStyle}" ToolTip="Virtual controller: what games will see" AutomationProperties.Name="Virtual controller"
                                          IsChecked="{Binding IsOutputMenuOpen, Mode=TwoWay}"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=OutputPopup, Converter={StaticResource InverseBool}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Path Data="{StaticResource IconXboxLogo}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayStationOutput}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <Path Data="{StaticResource IconPlayStationLogo}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform"
                                              Visibility="{Binding IsPlayStationOutput, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="Virtual controller" Margin="12,0,0,0" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                    <Popup x:Name="OutputPopup" IsOpen="{Binding IsOutputMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=OutputToggle}"
                           Placement="Top" HorizontalOffset="-10" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="260" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="VIRTUAL CONTROLLER" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="4,2,0,8" />
                                <ListBox ItemsSource="{Binding VirtualControllerOptions}" SelectedValuePath="Type"
                                         SelectedValue="{Binding SelectedVirtualController, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextPrimary}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                            <Setter Property="ToolTip" Value="{Binding Note}" />
                                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="14" Margin="4,3" Foreground="{StaticResource BrushTextPrimary}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <!-- Hide the original controller from games (HidHide) -->
                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding HideInputDevice, Mode=TwoWay}" IsEnabled="{Binding IsHidHideAvailable}"
                                  Margin="8,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Hide Physical Device" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleButton.ToolTip>
                            <StackPanel Margin="2">
                                <TextBlock Text="Hide original controller from games (HidHide)" FontWeight="Bold" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding HideStatusText}" Foreground="#B0B8C4" />
                            </StackPanel>
                        </ToggleButton.ToolTip>
                    </ToggleButton>
                    <TextBlock Text="Virtual controller driver (ViGEmBus) is not installed" Foreground="{StaticResource BrushOrange}" FontSize="11" VerticalAlignment="Center"
                               Margin="12,0" TextWrapping="Wrap" Visibility="{Binding ShowDriverWarning, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <Grid MinHeight="36" Margin="12,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushTextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsControllerConnected}" Value="True">
                                                <Setter Property="Fill" Value="#2EF2A0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" x:Name="DeviceText" Text="{Binding DeviceName}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="12,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxHeight="34" ToolTip="{Binding DeviceName}" />
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" Margin="12,0,0,12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WORKSPACE -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Getting started: three plain steps, shown until dismissed or remapping has been started once -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,0" Height="48" Margin="24,16,24,0"
                        Visibility="{Binding ShowGettingStarted, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Text="New here?  1. Click a button on the controller.   2. Choose what it should do on the right, then press Save.   3. Press Start." />
                        <Button Grid.Column="1" Content="Got it" Command="{Binding DismissGettingStartedCommand}" Style="{StaticResource BarButtonStyle}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Header: which config, and the one action -->
                <Grid Grid.Row="1" Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedProfile.Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SelectedProfile.ProcessExecutable, TargetNullValue='All applications'}" Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                            <TextBlock Text="·" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="8,0" />
                            <TextBlock Text="{Binding SaveStateText}" Foreground="{StaticResource BrushTextMuted}" FontSize="12"
                                       ToolTip="Configs save themselves a moment after you change them" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Layer" Foreground="{StaticResource BrushTextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox ItemsSource="{Binding LayerNames}" SelectedIndex="{Binding ActiveShiftLayer, Mode=TwoWay}"
                                  Width="144" ToolTip="Layers: other sets of mappings, switched to with a button" AutomationProperties.Name="Layer" />
                        <!-- How this layer is reached: which buttons, and hold vs toggle -->
                        <ToggleButton x:Name="LayerToggle" Style="{StaticResource CircleToggleStyle}" Content="&#xE713;" Margin="8,0,0,0"
                                      ToolTip="Layer activation (buttons and hold/toggle)" AutomationProperties.Name="Layer activation"
                                      IsEnabled="{Binding IsLayerEditable}"
                                      IsChecked="{Binding IsLayerMenuOpen, Mode=TwoWay}"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=LayerPopup, Converter={StaticResource InverseBool}}" />
                        <Button Style="{StaticResource CircleButtonStyle}" Content="&#xE74E;" Margin="8,0,0,0" ToolTip="Save this config now"
                                AutomationProperties.Name="Save this config now" Command="{Binding SaveProfileCommand}" />

                        <!-- Start / stop remapping: the one white action; beside it the slot picker (Windows) -->
                        <Grid Height="36" Margin="16,0,0,0" VerticalAlignment="Center">
                            <ToggleButton x:Name="SlotToggle" Style="{StaticResource ApplySlotToggleStyle}" Width="68" HorizontalAlignment="Left" Margin="68,0,0,0"
                                          Visibility="{Binding SupportsVirtualController, Converter={StaticResource BoolToVisibility}}"
                                          ToolTip="Which controller slot (1 to 4) the virtual controller takes" AutomationProperties.Name="Controller slot"
                                          IsChecked="{Binding IsSlotMenuOpen, Mode=TwoWay}"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=SlotPopup, Converter={StaticResource InverseBool}}">
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="30,0,0,0" VerticalAlignment="Center" />
                            </ToggleButton>
                            <Button Command="{Binding ToggleApplyCommand}" Style="{StaticResource ApplySplitButtonStyle}" Width="104" HorizontalAlignment="Left"
                                    ToolTip="{Binding ApplyButtonText}" AutomationProperties.Name="Start or stop remapping">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPlay}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRemappingActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <Path Data="{StaticResource IconStop}" Fill="#2EF2A0" Stretch="Uniform" Margin="1"
                                              Visibility="{Binding IsRemappingActive, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding ApplyLabel}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                    <Popup x:Name="LayerPopup" IsOpen="{Binding IsLayerMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=LayerToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="300" Margin="0,4,0,0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="ACTIVATE THIS LAYER WITH" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                <TextBlock Text="Pick up to 4 buttons; all must be held together." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding LayerModifierOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Width="136" Margin="0,0,0,6"
                                                      Foreground="{StaticResource BrushTextPrimary}" FontSize="12" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="BEHAVIOUR" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,10,0,6" />
                                <ComboBox ItemsSource="{Binding AvailableLayerTypes}" SelectedItem="{Binding SelectedLayerType}" />
                                <TextBlock Text="Hold: active while held. Toggle: each press switches it on or off." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="LEFT STICK IN THIS LAYER" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,10,0,6" />
                                <ComboBox ItemsSource="{Binding LayerStickChoices}" SelectedIndex="{Binding LayerLeftStickIndex}" />
                                <TextBlock Text="RIGHT STICK IN THIS LAYER" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,10,0,6" />
                                <ComboBox ItemsSource="{Binding LayerStickChoices}" SelectedIndex="{Binding LayerRightStickIndex}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="SlotPopup" IsOpen="{Binding IsSlotMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SlotToggle}"
                           Placement="Bottom" HorizontalOffset="0" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="120" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="10">
