<Window x:Class="ReWASD.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ReWASD.UI.ViewModels"
        xmlns:views="clr-namespace:ReWASD.UI.Views"
        mc:Ignorable="d"
        Title="ReWASD Open Source — Gamepad Remapper" 
        Height="720" Width="1200"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="64" />
            <!-- Shift Layers Sub-bar -->
            <RowDefinition Height="42" />
            <!-- Main Content (Sidebar | Visualizer | Inspector) -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- 1. TOP APP BAR -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Brand & Profile Selector -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Slots Selector -->
                    <ColumnDefinition Width="*" />
                    <!-- Apply & Status Actions -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & Profile Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="reWASD" Foreground="{StaticResource BrushCyan}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="· Open Source" Foreground="{StaticResource BrushTextMuted}" FontSize="14" Margin="6,0,24,0" VerticalAlignment="Center" />

                    <!-- Profile Dropdown -->
                    <TextBlock Text="PROFILE:" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Profiles}" 
                              SelectedItem="{Binding SelectedProfile}" 
                              DisplayMemberPath="Name"
                              Width="220" 
                              Background="{StaticResource BrushBgCard}" 
                              Foreground="{StaticResource BrushTextPrimary}" 
                              BorderBrush="{StaticResource BrushBorder}" 
                              VerticalAlignment="Center" 
                              Padding="10,6" />

                    <Button Content="+" Command="{Binding NewProfileCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="8,0,0,0" 
                            ToolTip="Create New Profile" 
                            VerticalAlignment="Center" 
                            Width="32" Height="32" Padding="0" />
                </StackPanel>

                <!-- Slots Selector (Center) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="SLOT:" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton Content="1" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="1" IsChecked="True" Margin="0,0,4,0" />
                    <RadioButton Content="2" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="2" Margin="0,0,4,0" />
                    <RadioButton Content="3" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="3" Margin="0,0,4,0" />
                    <RadioButton Content="4" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="4" />
                </StackPanel>

                <!-- Apply & Remap Toggle Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding IsRemappingActive, Converter={x:Null}, FallbackValue='APPLY'}" 
                            Command="{Binding ToggleApplyCommand}"
                            Style="{StaticResource ApplyButtonStyle}" 
                            Margin="0,0,12,0">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" Margin="0,0,6,0" />
                                    <TextBlock Text="APPLY" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. SHIFT LAYERS SUB-BAR -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CONFIG LAYER:" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                <RadioButton Content="MAIN" Style="{StaticResource ShiftTabButtonStyle}" Command="{Binding SelectShiftLayerCommand}" CommandParameter="0" IsChecked="True" Margin="0,0,8,0" />
                <RadioButton Content="SHIFT 1" Style="{StaticResource ShiftTabButtonStyle}" Command="{Binding SelectShiftLayerCommand}" CommandParameter="1" Margin="0,0,8,0" />
                <RadioButton Content="SHIFT 2" Style="{StaticResource ShiftTabButtonStyle}" Command="{Binding SelectShiftLayerCommand}" CommandParameter="2" Margin="0,0,8,0" />
                <RadioButton Content="SHIFT 3" Style="{StaticResource ShiftTabButtonStyle}" Command="{Binding SelectShiftLayerCommand}" CommandParameter="3" Margin="0,0,8,0" />
                <RadioButton Content="SHIFT 4" Style="{StaticResource ShiftTabButtonStyle}" Command="{Binding SelectShiftLayerCommand}" CommandParameter="4" />
            </StackPanel>
        </Border>

        <!-- 3. MAIN CONTENT: (SIDEBAR | VISUALIZER | INSPECTOR) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar: Devices -->
                <ColumnDefinition Width="230" MinWidth="200" />
                <!-- Center: Controller Visualizer -->
                <ColumnDefinition Width="*" MinWidth="500" />
                <!-- Right: Mapping Inspector -->
                <ColumnDefinition Width="320" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Left Device Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="CONNECTED DEVICES" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12" />
                    
                    <ItemsControl ItemsSource="{Binding ConnectedDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Margin="0,12,0,12" />

                    <TextBlock Text="DEVICE GROUPING" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <CheckBox Content="Group with Keyboard &amp; Mouse" IsChecked="True" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4" />
                    <CheckBox Content="Hook Mouse Cursor for Sticks" IsChecked="False" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4" />
                    <CheckBox Content="Virtual Controller: Xbox 360" IsChecked="True" IsEnabled="False" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4" />
                </StackPanel>
            </Border>

            <!-- Center Stage: Controller Visualizer -->
            <Border Grid.Column="1" Background="{StaticResource BrushBgDeep}">
                <views:ControllerVisualizer />
            </Border>

            <!-- Right Inspector: Mapping Panel -->
            <views:MappingPanel Grid.Column="2" />
        </Grid>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" />
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ViGEmBus: Ready" Foreground="{StaticResource BrushGreen}" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <TextBlock Text="v0.1.0-alpha" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
