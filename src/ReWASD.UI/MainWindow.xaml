<Window x:Class="ReWASD.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ReWASD.UI.ViewModels"
        xmlns:views="clr-namespace:ReWASD.UI.Views"
        xmlns:conv="clr-namespace:ReWASD.UI.Converters"
        mc:Ignorable="d"
        Title="ReWASD Open Source — Gamepad Remapper"
        Height="720" Width="1200"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Status-bar indicator: green when the dependency is present, orange otherwise -->
        <Style x:Key="StatusIndicator" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource BrushOrange}" />
        </Style>

        <DataTemplate x:Key="ProfileItemTemplate">
            <StackPanel Margin="2,4">
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ProcessExecutable, TargetNullValue='All applications'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="64" />
            <!-- Shift Layers Sub-bar -->
            <RowDefinition Height="42" />
            <!-- Main Content (Navigation | Visualizer | Inspector) -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- 1. TOP APP BAR -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="reWASD" Foreground="{StaticResource BrushCyan}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="· Open Source" Foreground="{StaticResource BrushTextMuted}" FontSize="14" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Slots Selector (Center) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="SLOT:" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton Content="1" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="1" IsChecked="True" Margin="0,0,4,0" />
                    <RadioButton Content="2" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="2" Margin="0,0,4,0" />
                    <RadioButton Content="3" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="3" Margin="0,0,4,0" />
                    <RadioButton Content="4" Style="{StaticResource SlotButtonStyle}" Command="{Binding SelectSlotCommand}" CommandParameter="4" />
                </StackPanel>

                <!-- Apply & Remap Toggle Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleApplyCommand}"
                            Style="{StaticResource ApplyButtonStyle}"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,6,0" />
                            <TextBlock Text="APPLY" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. SHIFT LAYERS SUB-BAR -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CONFIG LAYER:" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                <RadioButton Content="MAIN" Style="{StaticResource ShiftTabButtonStyle}" Command="{Binding SelectShiftLayerCommand}" CommandParameter="0" IsChecked="True" Margin="0,0,8,0" />
                <RadioButton Content="SHIFT 1" Style="{StaticResource ShiftTabButtonStyle}" Command="{Binding SelectShiftLayerCommand}" CommandParameter="1" Margin="0,0,8,0" />
                <RadioButton Content="SHIFT 2" Style="{StaticResource ShiftTabButtonStyle}" Command="{Binding SelectShiftLayerCommand}" CommandParameter="2" Margin="0,0,8,0" />
                <RadioButton Content="SHIFT 3" Style="{StaticResource ShiftTabButtonStyle}" Command="{Binding SelectShiftLayerCommand}" CommandParameter="3" Margin="0,0,8,0" />
                <RadioButton Content="SHIFT 4" Style="{StaticResource ShiftTabButtonStyle}" Command="{Binding SelectShiftLayerCommand}" CommandParameter="4" />
            </StackPanel>
        </Border>

        <!-- 3. MAIN CONTENT: (NAVIGATION | VISUALIZER | INSPECTOR) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="220" />
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="320" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Left: navigation, configs, devices -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Page navigation -->
                    <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,14">
                        <RadioButton Content="Remap" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,0"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Remap}" />
                        <RadioButton Content="Preferences" Style="{StaticResource ShiftTabButtonStyle}"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Preferences}" />
                    </UniformGrid>

                    <!-- Configs header -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="CONFIGS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="+" Command="{Binding NewProfileCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" ToolTip="Create New Config"
                                Width="28" Height="28" Padding="0" />
                    </DockPanel>

                    <!-- Config list: each profile targets a game process -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                             ItemTemplate="{StaticResource ProfileItemTemplate}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextPrimary}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                    <!-- Selected config's target process -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="Target process (blank = all)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SelectedProcessExecutable, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushTextPrimary}"
                                 BorderBrush="{StaticResource BrushBorder}" Padding="8,6" />
                    </StackPanel>

                    <!-- Devices -->
                    <StackPanel Grid.Row="4" Margin="0,14,0,0">
                        <TextBlock Text="CONNECTED DEVICES" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding ConnectedDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Center Stage: Controller Visualizer -->
            <Border Grid.Column="1" Background="{StaticResource BrushBgDeep}">
                <views:ControllerVisualizer />
            </Border>

            <!-- Right: binding frame (tabs + mapping inspector) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tabs for features that arrive one by one; disabled until implemented -->
                <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,0,1" Padding="10,8">
                    <UniformGrid Columns="3">
                        <RadioButton Content="Main" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,4"
                                     IsChecked="{Binding SelectedBindingTab, Converter={StaticResource EnumToBool}, ConverterParameter=Main}" />
                        <RadioButton Content="Shift" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,4" IsEnabled="False" Opacity="0.4" ToolTip="Not implemented yet" />
                        <RadioButton Content="Advanced" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,0,4" IsEnabled="False" Opacity="0.4" ToolTip="Not implemented yet" />
                        <RadioButton Content="Keyboard" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,0" IsEnabled="False" Opacity="0.4" ToolTip="Not implemented yet" />
                        <RadioButton Content="Rumble" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,0" IsEnabled="False" Opacity="0.4" ToolTip="Not implemented yet" />
                        <RadioButton Content="Mask" Style="{StaticResource ShiftTabButtonStyle}" IsEnabled="False" Opacity="0.4" ToolTip="Not implemented yet" />
                    </UniformGrid>
                </Border>

                <views:MappingPanel Grid.Row="1" />
            </Grid>

            <!-- Preferences page: covers the visualizer and inspector -->
            <Border Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource BrushBgDeep}" Padding="32"
                    Visibility="{Binding IsPreferencesPage, Converter={StaticResource BoolToVisibility}}">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Preferences" Foreground="{StaticResource BrushTextPrimary}" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" />

                    <TextBlock Text="DRIVERS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding DriverStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                            <TextBlock Text="Required to present a virtual Xbox 360 controller to games." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,10" />
                            <TextBlock Text="{Binding HidHideStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                            <TextBlock Text="Optional. Hides the physical controller so games only see the virtual one (used by 'Mute original hardware input')." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="OUTPUT" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Virtual controller: Xbox 360" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                            <TextBlock Text="Other output types are not implemented yet." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DriverStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusIndicator}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDriverAvailable}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushGreen}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding HidHideStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusIndicator}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHidHideAvailable}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushGreen}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="v0.1.0-alpha" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
