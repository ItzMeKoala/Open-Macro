<Window x:Class="ReWASD.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ReWASD.UI.ViewModels;assembly=ReWASD.App"
        xmlns:views="clr-namespace:ReWASD.UI.Views"
        xmlns:conv="clr-namespace:ReWASD.UI.Converters"
        mc:Ignorable="d"
        Title="ReWASD Open Source — Gamepad Remapper"
        Height="720" Width="1200"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Status indicator: orange by default, green when the dependency is present -->
        <Style x:Key="StatusIndicator" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource BrushOrange}" />
        </Style>

        <!-- Dark selection/hover look for the config list -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgCardHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgCard}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushCyan}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProfileItemTemplate">
            <StackPanel Margin="2,4">
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ProcessExecutable, TargetNullValue='All applications'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- One row of the output-device popup -->
        <Style x:Key="OutputRow" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />   <!-- config bar -->
            <RowDefinition Height="44" />   <!-- layer bar -->
            <RowDefinition Height="38" />   <!-- input-type tabs -->
            <RowDefinition Height="*" />    <!-- content -->
            <RowDefinition Height="46" />   <!-- device bar -->
            <RowDefinition Height="58" />   <!-- apply bar -->
        </Grid.RowDefinitions>

        <!-- 1. CONFIG BAR -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="ConfigToggle" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                  IsChecked="{Binding IsConfigMenuOpen, Mode=TwoWay}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=ConfigPopup, Converter={StaticResource InverseBool}}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent" Padding="4,6">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedProfile.Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Button Style="{StaticResource IconButton}" Content="&#xE74E;" Margin="10,0,0,0" ToolTip="Save config" Command="{Binding SaveProfileCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE946;" ToolTip="About" Command="{Binding ShowInfoCommand}" />

                    <!-- Config switcher -->
                    <Popup x:Name="ConfigPopup" IsOpen="{Binding IsConfigMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ConfigToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="300" Margin="0,4,0,0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="CONFIGS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" Width="28" Height="28" ToolTip="New config" Command="{Binding NewProfileCommand}" />
                                </DockPanel>
                                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                         ItemTemplate="{StaticResource ProfileItemTemplate}" MaxHeight="220"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextPrimary}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                <TextBlock Text="Target process (blank = all)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,10,0,4" />
                                <TextBox Text="{Binding SelectedProcessExecutable, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushTextPrimary}"
                                         BorderBrush="{StaticResource BrushBorder}" Padding="8,6" />
                                <TextBlock Text="START FROM A PRESET" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,12,0,6" />
                                <ItemsControl ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}" ToolTip="{Binding Description}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,0,4"
                                                    Command="{Binding DataContext.NewFromPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Import…" Command="{Binding ImportProfileCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,0" ToolTip="Open a config file someone sent you" />
                                    <Button Content="Export…" Command="{Binding ExportProfileCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,0" ToolTip="Save this config to share it" />
                                    <Button Content="Delete" Command="{Binding DeleteProfileCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" ToolTip="Delete this config (a copy stays in History)" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Preferences" Command="{Binding ToggleSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. LAYER BAR -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgPanel}" Padding="14,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding LayerNames}" SelectedIndex="{Binding ActiveShiftLayer, Mode=TwoWay}"
                          Width="150" Background="Transparent" BorderThickness="0" FontSize="14" />
                <!-- How this layer is reached: which buttons, and hold vs toggle -->
                <ToggleButton x:Name="LayerToggle" Style="{StaticResource IconToggle}" Content="&#xE713;" Width="34" Height="34" FontSize="15" Margin="4,0,0,0"
                              ToolTip="Layer activation (buttons and hold/toggle)"
                              IsEnabled="{Binding IsLayerEditable}"
                              IsChecked="{Binding IsLayerMenuOpen, Mode=TwoWay}"
                              IsHitTestVisible="{Binding IsOpen, ElementName=LayerPopup, Converter={StaticResource InverseBool}}" />
                <Popup x:Name="LayerPopup" IsOpen="{Binding IsLayerMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=LayerToggle}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Width="300" Margin="0,4,0,0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="ACTIVATE THIS LAYER WITH" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="Pick up to 4 buttons; all must be held together." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding LayerModifierOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Width="136" Margin="0,0,0,6"
                                                  Foreground="{StaticResource BrushTextPrimary}" FontSize="12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="BEHAVIOUR" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,10,0,6" />
                            <ComboBox ItemsSource="{Binding AvailableLayerTypes}" SelectedItem="{Binding SelectedLayerType}" />
                            <TextBlock Text="Hold: active while held. Toggle: each press switches it on or off." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="LEFT STICK IN THIS LAYER" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,10,0,6" />
                            <ComboBox ItemsSource="{Binding LayerStickChoices}" SelectedIndex="{Binding LayerLeftStickIndex}" />
                            <TextBlock Text="RIGHT STICK IN THIS LAYER" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,10,0,6" />
                            <ComboBox ItemsSource="{Binding LayerStickChoices}" SelectedIndex="{Binding LayerRightStickIndex}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Border>

        <!-- 3. INPUT-TYPE TABS -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgPanel}" Padding="14,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,10,0"
                             IsChecked="{Binding SelectedInputTab, Converter={StaticResource EnumToBool}, ConverterParameter=Gamepad}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Gamepad" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,10,0"
                             ToolTip="Remap keyboard keys (the original key is swallowed while remapping is on)"
                             IsChecked="{Binding SelectedInputTab, Converter={StaticResource EnumToBool}, ConverterParameter=Keyboard}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Keyboard" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ShiftTabButtonStyle}"
                             ToolTip="Remap mouse buttons and the wheel (the original is swallowed while remapping is on)"
                             IsChecked="{Binding SelectedInputTab, Converter={StaticResource EnumToBool}, ConverterParameter=Mouse}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE962;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Mouse" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 4. CONTENT: visualizer | inspector | icon rail -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The controller, keyboard or mouse drawing -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgDeep}">
                <views:InputSurface />
            </Border>

            <!-- Inspector -->
            <Border Grid.Column="1" Width="340">
                <views:MappingPanel />
            </Border>

            <!-- Preferences page: covers the visualizer and inspector -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource BrushBgDeep}" Padding="32"
                    Visibility="{Binding IsPreferencesPage, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Preferences" Foreground="{StaticResource BrushTextPrimary}" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" />

                    <TextBlock Text="DRIVERS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding DriverStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                            <TextBlock Text="Required to present a virtual Xbox 360 controller to games." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,10" />
                            <TextBlock Text="{Binding HidHideStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                            <TextBlock Text="Optional. Hides the physical controller so games only see the virtual one (the toggle switch in the bottom bar)." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding HideStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <Button Content="Show HidHide diagnostics" Command="{Binding ShowHidHideDiagnosticsCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left" Padding="12,5" Margin="0,8,0,0" ToolTip="Prints what HidHide has configured in the status bar" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="UPDATES" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding BuildText, StringFormat='This build: {0}'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                            <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Check now" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" />
                                <Button Content="Update now" Command="{Binding InstallUpdateCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" Margin="8,0,0,0"
                                        Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding UpdateProgress, Mode=OneWay}" Height="6" Margin="0,10,0,0"
                                         Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                            <CheckBox Content="Check for updates when ReWASD starts" IsChecked="{Binding AutoCheckUpdates}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="LEFT STICK (this config)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16" DataContext="{Binding LeftStickSettings}">
                        <StackPanel>
                            <ComboBox ItemsSource="{x:Static vm:StickViewModel.ModeNames}" SelectedIndex="{Binding ModeIndex}" />
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsMouse, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <TextBlock Text="Cursor speed" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="{Binding MouseSpeed, StringFormat='{}{0:0} px/s'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="100" Maximum="4000" SmallChange="50" LargeChange="200" Value="{Binding MouseSpeed}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsScroll, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <TextBlock Text="Scroll speed" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="{Binding ScrollSpeed, StringFormat='{}{0:0} /s'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="2" Maximum="60" SmallChange="1" LargeChange="5" Value="{Binding ScrollSpeed}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsKeys, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Keys" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{x:Static vm:StickViewModel.KeyPresetNames}" SelectedIndex="{Binding KeyPresetIndex}" />
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="Push this far to press" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="{Binding KeyThreshold, StringFormat='{}{0:P0}'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="0.1" Maximum="0.95" SmallChange="0.05" LargeChange="0.1" Value="{Binding KeyThreshold}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding CanBePrecise, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Slow down while holding" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{x:Static vm:StickViewModel.PrecisionNames}" SelectedIndex="{Binding PrecisionIndex}" />
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="Speed while slowed" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="{Binding PrecisionFactor, StringFormat='{}{0:P0}'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="0.05" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding PrecisionFactor}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="RIGHT STICK (this config)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16" DataContext="{Binding RightStickSettings}">
                        <StackPanel>
                            <ComboBox ItemsSource="{x:Static vm:StickViewModel.ModeNames}" SelectedIndex="{Binding ModeIndex}" />
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsMouse, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <TextBlock Text="Cursor speed" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="{Binding MouseSpeed, StringFormat='{}{0:0} px/s'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="100" Maximum="4000" SmallChange="50" LargeChange="200" Value="{Binding MouseSpeed}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsScroll, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <TextBlock Text="Scroll speed" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="{Binding ScrollSpeed, StringFormat='{}{0:0} /s'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="2" Maximum="60" SmallChange="1" LargeChange="5" Value="{Binding ScrollSpeed}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsKeys, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Keys" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{x:Static vm:StickViewModel.KeyPresetNames}" SelectedIndex="{Binding KeyPresetIndex}" />
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="Push this far to press" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="{Binding KeyThreshold, StringFormat='{}{0:P0}'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="0.1" Maximum="0.95" SmallChange="0.05" LargeChange="0.1" Value="{Binding KeyThreshold}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding CanBePrecise, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Slow down while holding" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{x:Static vm:StickViewModel.PrecisionNames}" SelectedIndex="{Binding PrecisionIndex}" />
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="Speed while slowed" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                    <TextBlock Text="{Binding PrecisionFactor, StringFormat='{}{0:P0}'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="0.05" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding PrecisionFactor}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="OBS STUDIO (for Obs: macro steps)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="In OBS: Tools, then WebSocket Server Settings, then Enable. Kept on this computer only." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ObsHost, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" Padding="6,4" />
                                <TextBox Grid.Column="1" Text="{Binding ObsPort, UpdateSourceTrigger=LostFocus}" Padding="6,4" />
                            </Grid>
                            <TextBlock Text="Password (if you set one)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,8,0,2" />
                            <TextBox x:Name="ObsPasswordBox" Padding="6,4" Text="{Binding ObsPassword, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="PROFILES AND LOCK" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox Content="Switch profile to match the app in front" IsChecked="{Binding AutoSwitchProfiles}" IsEnabled="{Binding CanAutoSwitch, Mode=OneTime}"
                                      Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                            <TextBlock Text="Give a profile a target app (the box under the profile list, e.g. game.exe) and it takes over while that app is in front." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,12" />

                            <TextBlock Text="Lock the controller by holding" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{x:Static vm:MainViewModel.LockChordNames}" SelectedIndex="{Binding LockChordIndex}" />
                            <TextBlock Text="Hold them for a second to lock; again to unlock. While locked the controller does nothing." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <ToggleButton Content="Controller locked" IsChecked="{Binding IsControllerLocked, Mode=OneWay}" Command="{Binding ToggleLockCommand}" HorizontalAlignment="Left" Padding="12,5" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="HISTORY" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding HistoryHint}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding HistoryEntries}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="Restore" Style="{StaticResource SecondaryButtonStyle}" Padding="10,3" FontSize="11"
                                                    Command="{Binding DataContext.RestoreHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="COMBOS (this config)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="A chord is buttons pressed together; a sequence is buttons pressed in order. Each does an action of its own." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Combos}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource SecondaryButtonStyle}" Padding="10,3" FontSize="11"
                                                    Command="{Binding DataContext.RemoveComboCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="New combo" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" Margin="0,10,0,4" />
                            <ComboBox ItemsSource="{x:Static vm:MainViewModel.ComboKindNames}" SelectedIndex="{Binding NewComboKindIndex}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewComboButtons, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" Padding="6,4" ToolTip="Buttons, e.g. A + B   or   Up Up Down Down" />
                                <Button Grid.Column="1" Content="Capture" Command="{Binding CaptureComboButtonsCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" ToolTip="Press the buttons on your controller instead of typing them" />
                            </Grid>
                            <TextBlock Text="Action, written like a macro (KeyTap:Space, Obs:record, ...)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,6,0,2" />
                            <TextBox Text="{Binding NewComboAction, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            <ComboBox ItemsSource="{x:Static vm:MainViewModel.ComboRepeatNames}" SelectedIndex="{Binding NewComboRepeatIndex}" Margin="0,6,0,0" />
                            <Button Content="Add combo" Command="{Binding AddComboCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" Margin="0,8,0,0" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding ComboMessage}" Foreground="{StaticResource BrushOrange}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />

                            <DockPanel Margin="0,12,0,0">
                                <TextBlock Text="Chord window" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                <TextBlock Text="{Binding ChordWindowMs, StringFormat='{}{0} ms'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <Slider Minimum="30" Maximum="400" SmallChange="5" LargeChange="20" Value="{Binding ChordWindowMs}" Margin="0,4,0,0" />
                            <TextBlock Text="Buttons that are part of a chord wait this long before acting alone." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="USAGE (this computer only)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding UsageSummary}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding TopButtonLines}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource BrushCyan}" FontSize="12" FontFamily="Consolas" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Counted only on this computer; nothing is ever sent anywhere." Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,8,0,0" />
                            <Button Content="Reset counts" Command="{Binding ResetUsageCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="OVERLAY (for streams)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <ToggleButton Content="Show the controller overlay" IsChecked="{Binding ShowOverlay}" HorizontalAlignment="Left" Padding="12,5" />
                            <TextBlock Text="A small window that stays on top and shows your controller moving. Drag it where you want it and resize it from its corner; capture it with a window capture in OBS. Turn it off here." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ACTIVATOR TIMING (this config)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Long press after" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                <TextBlock Text="{Binding LongPressMs, StringFormat='{}{0} ms'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <Slider Minimum="150" Maximum="1500" SmallChange="10" LargeChange="50" Value="{Binding LongPressMs}" Margin="0,4,0,12" />

                            <DockPanel>
                                <TextBlock Text="Double / triple press window" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                <TextBlock Text="{Binding MultiPressWindowMs, StringFormat='{}{0} ms'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <Slider Minimum="80" Maximum="800" SmallChange="10" LargeChange="50" Value="{Binding MultiPressWindowMs}" Margin="0,4,0,12" />

                            <DockPanel>
                                <TextBlock Text="One-time pulse length" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                <TextBlock Text="{Binding PulseMs, StringFormat='{}{0} ms'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <Slider Minimum="10" Maximum="300" SmallChange="5" LargeChange="20" Value="{Binding PulseMs}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SAFETY" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Panic key: Ctrl + Alt + Shift + F12" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                            <TextBlock Text="Stops remapping immediately and gives every key and mouse button back, even if a mapping has taken over something you need." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="OUTPUT" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Virtual controller: Xbox 360" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                            <TextBlock Text="Other output types are not implemented yet." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 5. DEVICE BAR -->
        <Border Grid.Row="4" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource BrushCyan}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConnectedDevices[0]}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DriverStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusIndicator}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDriverAvailable}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushGreen}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding HidHideStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusIndicator}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHidHideAvailable}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushGreen}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding BuildText}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 6. APPLY BAR -->
        <Border Grid.Row="5" Background="{StaticResource BrushBgDeep}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Start / stop remapping -->
                    <Button Command="{Binding ToggleApplyCommand}" Style="{StaticResource ApplyButtonStyle}" MinWidth="150" Height="42">
                        <TextBlock FontWeight="Bold" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="APPLY" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRemappingActive}" Value="True">
                                            <Setter Property="Text" Value="STOP" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Slot -->
                    <ComboBox ItemsSource="{Binding SlotNumbers}" SelectedItem="{Binding ActiveSlot, Mode=TwoWay}"
                              Width="96" Height="42" FontSize="15" FontWeight="SemiBold" Margin="8,0,14,0" VerticalAlignment="Center"
                              ToolTip="Slot" />

                    <!-- Virtual controller: which controller games will see -->
                    <ToggleButton x:Name="OutputToggle" Style="{StaticResource IconToggle}" Content="&#xE7FC;" Width="46" Height="42" Margin="0,0,6,0"
                                  ToolTip="Virtual controller: what games will see"
                                  IsChecked="{Binding IsOutputMenuOpen, Mode=TwoWay}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=OutputPopup, Converter={StaticResource InverseBool}}" />

                    <Popup x:Name="OutputPopup" IsOpen="{Binding IsOutputMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=OutputToggle}"
                           Placement="Top" HorizontalOffset="-10" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="340" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="VIRTUAL CONTROLLER" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="4,2,0,8" />
                                <ListBox ItemsSource="{Binding VirtualControllerOptions}" SelectedValuePath="Type"
                                         SelectedValue="{Binding SelectedVirtualController, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextPrimary}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                            <Setter Property="ToolTip" Value="{Binding Note}" />
                                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="14" Margin="4,3" Foreground="{StaticResource BrushTextPrimary}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Hide the original controller from games (HidHide) -->
                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding HideInputDevice, Mode=TwoWay}" IsEnabled="{Binding IsHidHideAvailable}"
                                  Margin="6,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Hide Physical Device" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleButton.ToolTip>
                            <StackPanel Margin="2">
                                <TextBlock Text="Hide original controller from games (HidHide)" FontWeight="Bold" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding HideStatusText}" Foreground="#B0B8C4" />
                            </StackPanel>
                        </ToggleButton.ToolTip>
                    </ToggleButton>

                    <!-- A newer build is ready: one click downloads it and restarts into it -->
                    <Button Content="Update available" Command="{Binding InstallUpdateCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="42" Padding="14,0" Margin="14,0,0,0"
                            Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding UpdateStatusText}" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding UpdateProgress, Mode=OneWay}" Width="120" Height="8" Margin="14,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

    </Grid>
</Window>
