<Window x:Class="ReWASD.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ReWASD.UI.ViewModels"
        xmlns:views="clr-namespace:ReWASD.UI.Views"
        xmlns:conv="clr-namespace:ReWASD.UI.Converters"
        mc:Ignorable="d"
        Title="ReWASD Open Source — Gamepad Remapper"
        Height="720" Width="1200"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Status indicator: orange by default, green when the dependency is present -->
        <Style x:Key="StatusIndicator" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource BrushOrange}" />
        </Style>

        <!-- Dark selection/hover look for the config list -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgCardHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgCard}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushCyan}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProfileItemTemplate">
            <StackPanel Margin="2,4">
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ProcessExecutable, TargetNullValue='All applications'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- One row of the output-device popup -->
        <Style x:Key="OutputRow" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />   <!-- config bar -->
            <RowDefinition Height="44" />   <!-- layer bar -->
            <RowDefinition Height="38" />   <!-- input-type tabs -->
            <RowDefinition Height="*" />    <!-- content -->
            <RowDefinition Height="46" />   <!-- device bar -->
            <RowDefinition Height="58" />   <!-- apply bar -->
        </Grid.RowDefinitions>

        <!-- 1. CONFIG BAR -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="ConfigToggle" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                  IsChecked="{Binding IsConfigMenuOpen, Mode=TwoWay}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=ConfigPopup, Converter={StaticResource InverseBool}}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent" Padding="4,6">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedProfile.Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Button Style="{StaticResource IconButton}" Content="&#xE74E;" Margin="10,0,0,0" ToolTip="Save config" Command="{Binding SaveProfileCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE946;" ToolTip="About" Command="{Binding ShowInfoCommand}" />

                    <!-- Config switcher -->
                    <Popup x:Name="ConfigPopup" IsOpen="{Binding IsConfigMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ConfigToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="300" Margin="0,4,0,0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="CONFIGS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" Width="28" Height="28" ToolTip="New config" Command="{Binding NewProfileCommand}" />
                                </DockPanel>
                                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                         ItemTemplate="{StaticResource ProfileItemTemplate}" MaxHeight="220"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextPrimary}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                <TextBlock Text="Target process (blank = all)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,10,0,4" />
                                <TextBox Text="{Binding SelectedProcessExecutable, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushTextPrimary}"
                                         BorderBrush="{StaticResource BrushBorder}" Padding="8,6" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Preferences" Command="{Binding ToggleSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. LAYER BAR -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgPanel}" Padding="14,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding LayerNames}" SelectedIndex="{Binding ActiveShiftLayer, Mode=TwoWay}"
                          Width="150" Background="Transparent" BorderThickness="0" FontSize="14" />
                <!-- How this layer is reached: which buttons, and hold vs toggle -->
                <ToggleButton x:Name="LayerToggle" Style="{StaticResource IconToggle}" Content="&#xE713;" Width="34" Height="34" FontSize="15" Margin="4,0,0,0"
                              ToolTip="Layer activation (buttons and hold/toggle)"
                              IsEnabled="{Binding IsLayerEditable}"
                              IsChecked="{Binding IsLayerMenuOpen, Mode=TwoWay}"
                              IsHitTestVisible="{Binding IsOpen, ElementName=LayerPopup, Converter={StaticResource InverseBool}}" />
                <Popup x:Name="LayerPopup" IsOpen="{Binding IsLayerMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=LayerToggle}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Width="300" Margin="0,4,0,0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="ACTIVATE THIS LAYER WITH" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="Pick up to 4 buttons; all must be held together." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding LayerModifierOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Width="136" Margin="0,0,0,6"
                                                  Foreground="{StaticResource BrushTextPrimary}" FontSize="12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="BEHAVIOUR" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,10,0,6" />
                            <ComboBox ItemsSource="{Binding AvailableLayerTypes}" SelectedItem="{Binding SelectedLayerType}" />
                            <TextBlock Text="Hold: active while held. Toggle: each press switches it on or off." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Border>

        <!-- 3. INPUT-TYPE TABS -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgPanel}" Padding="14,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,10,0"
                             IsChecked="{Binding SelectedInputTab, Converter={StaticResource EnumToBool}, ConverterParameter=Gamepad}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Gamepad" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,10,0"
                             ToolTip="Remap keyboard keys (the original key is swallowed while remapping is on)"
                             IsChecked="{Binding SelectedInputTab, Converter={StaticResource EnumToBool}, ConverterParameter=Keyboard}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Keyboard" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ShiftTabButtonStyle}"
                             ToolTip="Remap mouse buttons and the wheel (the original is swallowed while remapping is on)"
                             IsChecked="{Binding SelectedInputTab, Converter={StaticResource EnumToBool}, ConverterParameter=Mouse}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE962;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Mouse" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 4. CONTENT: visualizer | inspector | icon rail -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushBgDeep}">
                <Grid>
                    <views:ControllerVisualizer Visibility="{Binding IsGamepadTab, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Key / mouse button picker: choose the input to remap -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24"
                                  Visibility="{Binding IsSourcePickerTab, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Pick the input to remap" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding CurrentSources}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding SelectCommand}" Width="{Binding Width}" Height="{Binding Height}"
                                                Margin="0,0,8,8" Cursor="Hand" ToolTip="{Binding TargetText}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                                    <Setter Property="Background" Value="{StaticResource BrushBgCard}" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BrushBorder}"
                                                                        BorderThickness="1" CornerRadius="6">
                                                                    <TextBlock Text="{Binding DisplayName}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                                                               Foreground="{TemplateBinding Foreground}" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgCardHover}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRemapped}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushOrange}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
                                                        </DataTrigger>
                                                        <!-- Physically held right now -->
                                                        <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                            <Setter Property="Background" Value="#9C7E2C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Inspector (binding frame) -->
            <Border Grid.Column="1" Width="330" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tabs for features that arrive one by one; disabled until implemented -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="10,8">
                        <UniformGrid Columns="3">
                            <RadioButton Content="Main" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,4"
                                         IsChecked="{Binding SelectedBindingTab, Converter={StaticResource EnumToBool}, ConverterParameter=Main}" />
                            <RadioButton Content="Shift" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,4" IsEnabled="False" Opacity="0.4" ToolTip="Not implemented yet" />
                            <RadioButton Content="Advanced" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,0,4" IsEnabled="False" Opacity="0.4" ToolTip="Not implemented yet" />
                            <RadioButton Content="Keyboard" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,0" IsEnabled="False" Opacity="0.4" ToolTip="Not implemented yet" />
                            <RadioButton Content="Rumble" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,0" IsEnabled="False" Opacity="0.4" ToolTip="Not implemented yet" />
                            <RadioButton Content="Mask" Style="{StaticResource ShiftTabButtonStyle}" IsEnabled="False" Opacity="0.4" ToolTip="Not implemented yet" />
                        </UniformGrid>
                    </Border>

                    <views:MappingPanel Grid.Row="1" />
                </Grid>
            </Border>

            <!-- Right icon rail -->
            <Border Grid.Column="2" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE70F;" ToolTip="Mapping inspector" Margin="0,0,0,10"
                                  IsChecked="{Binding IsInspectorOpen, Mode=TwoWay}" />
                    <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE7FC;" ToolTip="Gamepad settings — not implemented yet" Margin="0,0,0,10" IsEnabled="False" />
                    <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE765;" ToolTip="Keyboard overlay — not implemented yet" Margin="0,0,0,10" IsEnabled="False" />
                    <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE9D9;" ToolTip="Macros — see the Macro target in the inspector" IsEnabled="False" />
                </StackPanel>
            </Border>

            <!-- Preferences page: covers the visualizer and inspector -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource BrushBgDeep}" Padding="32"
                    Visibility="{Binding IsPreferencesPage, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Preferences" Foreground="{StaticResource BrushTextPrimary}" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" />

                    <TextBlock Text="DRIVERS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding DriverStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                            <TextBlock Text="Required to present a virtual Xbox 360 controller to games." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,10" />
                            <TextBlock Text="{Binding HidHideStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                            <TextBlock Text="Optional. Hides the physical controller so games only see the virtual one (used by 'Mute' and 'Hide input device')." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ACTIVATOR TIMING (this config)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Long press after" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                <TextBlock Text="{Binding LongPressMs, StringFormat='{}{0} ms'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <Slider Minimum="150" Maximum="1500" SmallChange="10" LargeChange="50" Value="{Binding LongPressMs}" Margin="0,4,0,12" />

                            <DockPanel>
                                <TextBlock Text="Double / triple press window" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                <TextBlock Text="{Binding MultiPressWindowMs, StringFormat='{}{0} ms'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <Slider Minimum="80" Maximum="800" SmallChange="10" LargeChange="50" Value="{Binding MultiPressWindowMs}" Margin="0,4,0,12" />

                            <DockPanel>
                                <TextBlock Text="One-time pulse length" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                <TextBlock Text="{Binding PulseMs, StringFormat='{}{0} ms'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <Slider Minimum="10" Maximum="300" SmallChange="5" LargeChange="20" Value="{Binding PulseMs}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SAFETY" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Panic key: Ctrl + Alt + Shift + F12" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                            <TextBlock Text="Stops remapping immediately and gives every key and mouse button back, even if a mapping has taken over something you need." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="OUTPUT" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Virtual controller: Xbox 360" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                            <TextBlock Text="Other output types are not implemented yet." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 5. DEVICE BAR -->
        <Border Grid.Row="4" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE7FC;" Width="38" Height="38" IsChecked="True" IsHitTestVisible="False" ToolTip="Physical gamepad" />
                    <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE765;" Width="38" Height="38" IsEnabled="False" ToolTip="Keyboard — not implemented yet" />
                    <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE962;" Width="38" Height="38" IsEnabled="False" ToolTip="Mouse — not implemented yet" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DriverStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusIndicator}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDriverAvailable}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushGreen}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding HidHideStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusIndicator}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHidHideAvailable}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushGreen}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ConnectedDevices[0]}" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="v0.1.0-alpha" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 6. APPLY BAR -->
        <Border Grid.Row="5" Background="{StaticResource BrushBgDeep}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Power: stops remapping; lit green while active -->
                    <Button Command="{Binding ToggleApplyCommand}" Content="&#xE7E8;" ToolTip="Start / stop remapping" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Width" Value="40" />
                                <Setter Property="Height" Value="40" />
                                <Setter Property="FontSize" Value="18" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRemappingActive}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushGreen}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding ToggleApplyCommand}" Style="{StaticResource ApplyButtonStyle}" MinWidth="170">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding ActiveSlot, StringFormat='Apply to Slot {0}'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRemappingActive}" Value="True">
                                            <Setter Property="Text" Value="Stop remapping" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <ComboBox ItemsSource="{Binding SlotNumbers}" SelectedItem="{Binding ActiveSlot, Mode=TwoWay}"
                              Width="64" Margin="4,0,12,0" VerticalAlignment="Center" ToolTip="Slot" />

                    <!-- Output device menu -->
                    <ToggleButton x:Name="OutputToggle" Style="{StaticResource IconToggle}" Content="&#xE7FC;" ToolTip="Output device"
                                  IsChecked="{Binding IsOutputMenuOpen, Mode=TwoWay}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=OutputPopup, Converter={StaticResource InverseBool}}" />

                    <Popup x:Name="OutputPopup" IsOpen="{Binding IsOutputMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=OutputToggle}"
                           Placement="Top" HorizontalOffset="-10" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="340" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <!-- Physical device -->
                                <Border Style="{StaticResource OutputRow}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource BrushCyan}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ConnectedDevices[0]}" Foreground="{StaticResource BrushCyan}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>

                                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" />

                                <!-- Virtual output types: only Xbox 360 exists so far -->
                                <Border Style="{StaticResource OutputRow}" Background="{StaticResource BrushBgCard}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" />
                                        <TextBlock Text="Virtual Xbox 360" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource OutputRow}" Opacity="0.4" ToolTip="Not implemented yet"><TextBlock Text="Virtual Xbox One" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" /></Border>
                                <Border Style="{StaticResource OutputRow}" Opacity="0.4" ToolTip="Not implemented yet"><TextBlock Text="Virtual DS4" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" /></Border>
                                <Border Style="{StaticResource OutputRow}" Opacity="0.4" ToolTip="Not implemented yet"><TextBlock Text="Virtual DS3" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" /></Border>
                                <Border Style="{StaticResource OutputRow}" Opacity="0.4" ToolTip="Not implemented yet"><TextBlock Text="Virtual Switch Pro" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" /></Border>

                                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" />

                                <StackPanel Margin="14,10,14,12">
                                    <CheckBox Content="Mute all" IsChecked="{Binding MuteAll}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" ToolTip="Hide the physical controller from games while remapping (needs HidHide)" />
                                    <CheckBox Content="Hide input device from the system" IsChecked="{Binding HideInputDevice}" IsEnabled="{Binding IsHidHideAvailable}" Foreground="{StaticResource BrushTextPrimary}" ToolTip="Needs HidHide" />
                                    <TextBlock Text="{Binding HideStatusText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <Button Content="HidHide diagnostics" Command="{Binding ShowHidHideDiagnosticsCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0" ToolTip="Show what HidHide has configured, in the status bar" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

    </Grid>
</Window>
