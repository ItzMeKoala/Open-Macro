<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ReWASD.Core\ReWASD.Core.csproj" />
    <ProjectReference Include="..\ReWASD.Engine\ReWASD.Engine.csproj" />
    <ProjectReference Include="..\ReWASD.App\ReWASD.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReWASD.UI.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\ReWASD.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Forms is only used for the notification-area icon; keep its names from clashing with WPF's -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\ReWASD.ico" />
  </ItemGroup>

</Project>
