<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Open-Macro palette: neutral charcoal surfaces in a few close tones, one gold accent. The same values as the macOS front end. -->
    <Color x:Key="ColorBgDeep">#0D0F12</Color>
    <Color x:Key="ColorBgNav">#101215</Color>
    <Color x:Key="ColorBgPanel">#111316</Color>
    <Color x:Key="ColorBgInset">#17191D</Color>
    <Color x:Key="ColorBgCard">#1D2024</Color>
    <Color x:Key="ColorBgControl">#292C31</Color>
    <Color x:Key="ColorBgCardHover">#35383E</Color>
    <Color x:Key="ColorBgSelected">#3D3F44</Color>
    <Color x:Key="ColorBorder">#2A2D33</Color>
    <Color x:Key="ColorBorderLight">#454A53</Color>
    <Color x:Key="ColorPrimary">#FFFFFF</Color>
    <Color x:Key="ColorOnPrimary">#20242C</Color>
    <Color x:Key="ColorFocus">#ADB8FF</Color>

    <!-- Accents: the "Cyan" keys are kept so existing views pick up the warm gold accent -->
    <Color x:Key="ColorCyan">#E9C46A</Color>
    <Color x:Key="ColorCyanHover">#F2D68F</Color>
    <Color x:Key="ColorCyanDark">#A8873A</Color>
    <Color x:Key="ColorOrange">#FFAA00</Color>
    <Color x:Key="ColorGreen">#00E676</Color>
    <Color x:Key="ColorYellow">#FFCC00</Color>

    <!-- Typography -->
    <Color x:Key="ColorTextPrimary">#F4F5F7</Color>
    <Color x:Key="ColorTextSecondary">#B8BCC5</Color>
    <Color x:Key="ColorTextMuted">#969DA9</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource ColorBgDeep}" />
    <SolidColorBrush x:Key="BrushBgNav" Color="{StaticResource ColorBgNav}" />
    <SolidColorBrush x:Key="BrushBgPanel" Color="{StaticResource ColorBgPanel}" />
    <SolidColorBrush x:Key="BrushBgInset" Color="{StaticResource ColorBgInset}" />
    <SolidColorBrush x:Key="BrushBgControl" Color="{StaticResource ColorBgControl}" />
    <SolidColorBrush x:Key="BrushBgSelected" Color="{StaticResource ColorBgSelected}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushOnPrimary" Color="{StaticResource ColorOnPrimary}" />
    <SolidColorBrush x:Key="BrushFocus" Color="{StaticResource ColorFocus}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}" />
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource ColorBorderLight}" />

    <SolidColorBrush x:Key="BrushCyan" Color="{StaticResource ColorCyan}" />
    <SolidColorBrush x:Key="BrushCyanHover" Color="{StaticResource ColorCyanHover}" />
    <SolidColorBrush x:Key="BrushCyanDark" Color="{StaticResource ColorCyanDark}" />
    <SolidColorBrush x:Key="BrushOrange" Color="{StaticResource ColorOrange}" />
    <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource ColorGreen}" />
    <SolidColorBrush x:Key="BrushYellow" Color="{StaticResource ColorYellow}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

</ResourceDictionary>
