<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ReWASD Signature Color Palette -->
    <Color x:Key="ColorBgDeep">#161617</Color>
    <Color x:Key="ColorBgPanel">#1E1E20</Color>
    <Color x:Key="ColorBgCard">#2A2A2C</Color>
    <Color x:Key="ColorBgCardHover">#363638</Color>
    <Color x:Key="ColorBorder">#3A3A3D</Color>
    <Color x:Key="ColorBorderLight">#4A4A4E</Color>

    <!-- Accents: the "Cyan" keys are kept so existing views pick up the warm gold accent -->
    <Color x:Key="ColorCyan">#E9C46A</Color>
    <Color x:Key="ColorCyanHover">#F2D68F</Color>
    <Color x:Key="ColorCyanDark">#A8873A</Color>
    <Color x:Key="ColorOrange">#FFAA00</Color>
    <Color x:Key="ColorGreen">#00E676</Color>
    <Color x:Key="ColorYellow">#FFCC00</Color>

    <!-- Typography -->
    <Color x:Key="ColorTextPrimary">#F4F7FB</Color>
    <Color x:Key="ColorTextSecondary">#8E9BAE</Color>
    <Color x:Key="ColorTextMuted">#566173</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource ColorBgDeep}" />
    <SolidColorBrush x:Key="BrushBgPanel" Color="{StaticResource ColorBgPanel}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}" />
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource ColorBorderLight}" />

    <SolidColorBrush x:Key="BrushCyan" Color="{StaticResource ColorCyan}" />
    <SolidColorBrush x:Key="BrushCyanHover" Color="{StaticResource ColorCyanHover}" />
    <SolidColorBrush x:Key="BrushCyanDark" Color="{StaticResource ColorCyanDark}" />
    <SolidColorBrush x:Key="BrushOrange" Color="{StaticResource ColorOrange}" />
    <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource ColorGreen}" />
    <SolidColorBrush x:Key="BrushYellow" Color="{StaticResource ColorYellow}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

</ResourceDictionary>
