<UserControl x:Class="ReWASD.UI.Views.TesterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:art="clr-namespace:ReWASD.UI.Art"
             xmlns:tc="clr-namespace:ReWASD.UI.TesterControls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="Soft" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Col" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- The bar that shows how far a trigger is pulled -->
        <Style x:Key="PressureBar" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#22252C" CornerRadius="6" />
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="6" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The reaction-test box changes colour with the state of the game -->
        <Style x:Key="ReactBox" TargetType="Border">
            <Setter Property="Background" Value="#22252C" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Height" Value="96" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tester.ReactionWait}" Value="True"><Setter Property="Background" Value="#4A3A18" /></DataTrigger>
                <DataTrigger Binding="{Binding Tester.ReactionGo}" Value="True"><Setter Property="Background" Value="#0E7A43" /></DataTrigger>
                <DataTrigger Binding="{Binding Tester.ReactionBad}" Value="True"><Setter Property="Background" Value="#6B2323" /></DataTrigger>
                <DataTrigger Binding="{Binding Tester.ReactionDone}" Value="True"><Setter Property="Background" Value="#1F3A5A" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBgDeep}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar of the tester -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="CONTROLLER TESTER" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="{Binding Tester.ControllerName}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <Border CornerRadius="10" Padding="10,3" VerticalAlignment="Center" Background="#1F3A2A" Visibility="{Binding Tester.Connected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="CONNECTED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGreen}" />
                    </Border>
                    <Border CornerRadius="10" Padding="10,3" VerticalAlignment="Center" Background="#3A2A1F">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tester.Connected}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="NO CONTROLLER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushOrange}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,36,0">
                        <TextBlock Text="SESSION" Style="{StaticResource Col}" />
                        <TextBlock Text="{Binding Tester.SessionText}" Style="{StaticResource Mono}" FontSize="16" />
                    </StackPanel>
                    <StackPanel Margin="0,0,36,0">
                        <TextBlock Text="REPORT RATE" Style="{StaticResource Col}" />
                        <TextBlock Text="{Binding Tester.RateText}" Style="{StaticResource Mono}" FontSize="16" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CHANGES" Style="{StaticResource Col}" />
                        <TextBlock Text="{Binding Tester.TotalText}" Style="{StaticResource Mono}" FontSize="16" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Reset everything" Command="{Binding ResetTesterCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="0,0,8,0" />
                    <Button x:Name="ExitButton" Content="Exit full screen  (Esc)" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tile}" Margin="0,0,12,12" DataContext="{Binding Tester.Left}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource SecondaryButtonStyle}" Padding="10,3" FontSize="11"
                                    Command="{Binding DataContext.ResetTesterLeftStickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Text="LEFT STICK" Style="{StaticResource H}" />
                        </DockPanel>
                        <tc:StickPlot Height="250" Snapshot="{Binding Snapshot}" DeadzoneMin="{Binding DeadzoneMin}" DeadzoneMax="{Binding DeadzoneMax}" />
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource Big}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <UniformGrid Columns="3" Margin="0,10,0,0">
                            <StackPanel><TextBlock Text="PUSH" Style="{StaticResource Col}" /><TextBlock Text="{Binding MagnitudeText}" Style="{StaticResource Mono}" /></StackPanel>
                            <StackPanel><TextBlock Text="ANGLE" Style="{StaticResource Col}" /><TextBlock Text="{Binding AngleText}" Style="{StaticResource Mono}" /></StackPanel>
                            <StackPanel><TextBlock Text="PEAK" Style="{StaticResource Col}" /><TextBlock Text="{Binding PeakText}" Style="{StaticResource Mono}" /></StackPanel>
                        </UniformGrid>
                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,12" />
                        <TextBlock Text="CIRCULARITY TEST" Style="{StaticResource Col}" />
                        <TextBlock Text="{Binding CircleText}" Style="{StaticResource Soft}" Margin="0,2,0,6" />
                        <UniformGrid Columns="2">
                            <StackPanel><TextBlock Text="ROUNDNESS" Style="{StaticResource Col}" /><TextBlock Text="{Binding RoundnessText}" Style="{StaticResource Mono}" /></StackPanel>
                            <StackPanel><TextBlock Text="COVERAGE" Style="{StaticResource Col}" /><TextBlock Text="{Binding CoverageText}" Style="{StaticResource Mono}" /></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding RadiusText}" Style="{StaticResource Mono}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding RestText}" Style="{StaticResource Soft}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- THE CONTROLLER and the triggers (pressure) -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tile}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="LIVE" Style="{StaticResource H}" />
                        <art:ArtView Height="250" IsHitTestVisible="False" ShowEditing="False" Scene="{Binding SkinArt}" Sources="{Binding ControllerButtons}" />
                        <TextBlock Text="{Binding PressedText}" Style="{StaticResource Mono}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,12" />
                        <TextBlock Text="TRIGGERS  ·  PRESSURE" Style="{StaticResource H}" />
                        <StackPanel DataContext="{Binding Tester.LeftTrigger}" Margin="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Style="{StaticResource Big}" FontSize="18" />
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ProgressBar Style="{StaticResource PressureBar}" Minimum="0" Maximum="1" Value="{Binding Value, Mode=OneWay}" Height="12" Margin="0,6,0,4" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RawText}" Style="{StaticResource Mono}" FontSize="11" />
                                <TextBlock Text="{Binding PeakText}" Style="{StaticResource Mono}" FontSize="11" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PressesText}" Style="{StaticResource Soft}" FontSize="11" />
                                <TextBlock Text="{Binding StartText}" Style="{StaticResource Soft}" FontSize="11" />
                            </DockPanel>
                            <TextBlock Text="{Binding HeldText}" Style="{StaticResource Soft}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel DataContext="{Binding Tester.RightTrigger}" Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Style="{StaticResource Big}" FontSize="18" />
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ProgressBar Style="{StaticResource PressureBar}" Minimum="0" Maximum="1" Value="{Binding Value, Mode=OneWay}" Height="12" Margin="0,6,0,4" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RawText}" Style="{StaticResource Mono}" FontSize="11" />
                                <TextBlock Text="{Binding PeakText}" Style="{StaticResource Mono}" FontSize="11" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PressesText}" Style="{StaticResource Soft}" FontSize="11" />
                                <TextBlock Text="{Binding StartText}" Style="{StaticResource Soft}" FontSize="11" />
                            </DockPanel>
                            <TextBlock Text="{Binding HeldText}" Style="{StaticResource Soft}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Tile}" Margin="0,0,0,12" DataContext="{Binding Tester.Right}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource SecondaryButtonStyle}" Padding="10,3" FontSize="11"
                                    Command="{Binding DataContext.ResetTesterRightStickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Text="RIGHT STICK" Style="{StaticResource H}" />
                        </DockPanel>
                        <tc:StickPlot Height="250" Snapshot="{Binding Snapshot}" DeadzoneMin="{Binding DeadzoneMin}" DeadzoneMax="{Binding DeadzoneMax}" />
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource Big}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <UniformGrid Columns="3" Margin="0,10,0,0">
                            <StackPanel><TextBlock Text="PUSH" Style="{StaticResource Col}" /><TextBlock Text="{Binding MagnitudeText}" Style="{StaticResource Mono}" /></StackPanel>
                            <StackPanel><TextBlock Text="ANGLE" Style="{StaticResource Col}" /><TextBlock Text="{Binding AngleText}" Style="{StaticResource Mono}" /></StackPanel>
                            <StackPanel><TextBlock Text="PEAK" Style="{StaticResource Col}" /><TextBlock Text="{Binding PeakText}" Style="{StaticResource Mono}" /></StackPanel>
                        </UniformGrid>
                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,12" />
                        <TextBlock Text="CIRCULARITY TEST" Style="{StaticResource Col}" />
                        <TextBlock Text="{Binding CircleText}" Style="{StaticResource Soft}" Margin="0,2,0,6" />
                        <UniformGrid Columns="2">
                            <StackPanel><TextBlock Text="ROUNDNESS" Style="{StaticResource Col}" /><TextBlock Text="{Binding RoundnessText}" Style="{StaticResource Mono}" /></StackPanel>
                            <StackPanel><TextBlock Text="COVERAGE" Style="{StaticResource Col}" /><TextBlock Text="{Binding CoverageText}" Style="{StaticResource Mono}" /></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding RadiusText}" Style="{StaticResource Mono}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding RestText}" Style="{StaticResource Soft}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- BUTTONS: state, count, timing -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tile}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="BUTTONS  ·  PRESSES AND TIMING" Style="{StaticResource H}" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /><ColumnDefinition Width="76" /><ColumnDefinition Width="130" /><ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="BUTTON" Style="{StaticResource Col}" />
                            <TextBlock Grid.Column="2" Text="PRESSES" Style="{StaticResource Col}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="HOLD" Style="{StaticResource Col}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="SHORT – LONG" Style="{StaticResource Col}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="BOUNCE" Style="{StaticResource Col}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Tester.Buttons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /><ColumnDefinition Width="76" /><ColumnDefinition Width="130" /><ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="12" Height="12" Stroke="{StaticResource BrushBorderLight}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDown}" Value="True"><Setter Property="Fill" Value="{StaticResource BrushGreen}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Mono}" FontSize="11.5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding PressesText}" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding HoldText}" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding RangeText}" Style="{StaticResource Mono}" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="{Binding BounceText}" Style="{StaticResource Mono}" Foreground="{StaticResource BrushOrange}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="A bounce is a release and press less than 30 ms apart: a worn switch, not a finger." Style="{StaticResource Soft}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- GRAPH -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="LAST 6 SECONDS" Style="{StaticResource H}" />
                        <WrapPanel Margin="0,-2,0,10"><StackPanel Orientation="Horizontal" Margin="0,0,12,4"><Ellipse Width="9" Height="9" Fill="#E9C46A" Margin="0,0,5,0" /><TextBlock Text="Left X" Style="{StaticResource Soft}" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,12,4"><Ellipse Width="9" Height="9" Fill="#F4A261" Margin="0,0,5,0" /><TextBlock Text="Left Y" Style="{StaticResource Soft}" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,12,4"><Ellipse Width="9" Height="9" Fill="#5BC0EB" Margin="0,0,5,0" /><TextBlock Text="Right X" Style="{StaticResource Soft}" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,12,4"><Ellipse Width="9" Height="9" Fill="#9B8CFF" Margin="0,0,5,0" /><TextBlock Text="Right Y" Style="{StaticResource Soft}" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,12,4"><Ellipse Width="9" Height="9" Fill="#00E676" Margin="0,0,5,0" /><TextBlock Text="Left trigger" Style="{StaticResource Soft}" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,12,4"><Ellipse Width="9" Height="9" Fill="#FF6B6B" Margin="0,0,5,0" /><TextBlock Text="Right trigger" Style="{StaticResource Soft}" /></StackPanel></WrapPanel>
                        <TextBlock Text="Sticks  (−1 to +1)" Style="{StaticResource Col}" Margin="0,0,0,4" />
                        <tc:ScopeGraph Height="190" Series="{Binding Tester.Scope}" Channels="0,1,2,3" Minimum="-1" Maximum="1" />
                        <TextBlock Text="Triggers  (0 to 1)" Style="{StaticResource Col}" Margin="0,12,0,4" />
                        <tc:ScopeGraph Height="120" Series="{Binding Tester.Scope}" Channels="4,5" Minimum="0" Maximum="1" />
                    </StackPanel>
                </Border>

                <!-- TIMING and vibration -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Tile}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TIMING  ·  HOW OFTEN THE PAD REPORTS" Style="{StaticResource H}" />
                        <TextBlock Text="CHANGES PER SECOND" Style="{StaticResource Col}" />
                        <TextBlock Text="{Binding Tester.RateText}" Style="{StaticResource Big}" />
                        <TextBlock Text="{Binding Tester.IntervalText}" Style="{StaticResource Mono}" Margin="0,6,0,0" FontSize="11.5" />
                        <TextBlock Text="{Binding Tester.JitterText}" Style="{StaticResource Mono}" Margin="0,2,0,0" FontSize="11.5" />
                        <TextBlock Text="{Binding Tester.PeakRateText}" Style="{StaticResource Mono}" Margin="0,2,0,0" FontSize="11.5" />
                        <TextBlock Text="Move a stick steadily: a pad sends a reading each time it has something new, so this is its real update rate (Bluetooth is usually 60 – 250 a second, wired up to 1000). A big 'worst' gap or low 'steady' share means lag or dropped reports." Style="{StaticResource Soft}" FontSize="11" Margin="0,8,0,0" />

                        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,14" />
                        <TextBlock Text="REACTION TEST" Style="{StaticResource H}" />
                        <Border Style="{StaticResource ReactBox}">
                            <TextBlock Text="{Binding Tester.ReactionText}" Style="{StaticResource Big}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Tester.ReactionDetail}" Style="{StaticResource Soft}" FontSize="11" Margin="0,6,0,6" />
                        <Button Content="Start" Command="{Binding StartReactionTestCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" HorizontalAlignment="Left" />
                        <TextBlock Text="Includes up to one screen refresh (about 17 ms) of delay before you see the signal." Style="{StaticResource Soft}" FontSize="10" Margin="0,6,0,0" />

                        <StackPanel Margin="0,18,0,0" Visibility="{Binding CanVibrate, Converter={StaticResource BoolToVisibility}}">
                            <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,0,0,14" />
                            <TextBlock Text="VIBRATION TEST" Style="{StaticResource H}" />
                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                <Button Content="Left motor" Command="{Binding VibrateLeftCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,6,6" />
                                <Button Content="Right motor" Command="{Binding VibrateRightCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,0,6" />
                                <Button Content="Both" Command="{Binding VibrateBothCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,6,0" />
                                <Button Content="Stop" Command="{Binding StopVibrationCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" />
                            </UniformGrid>
                            <TextBlock Text="Each test shakes for under a second. The left motor is the heavy, low rumble; the right one is the light, fine buzz." Style="{StaticResource Soft}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- LOG -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="EVENT LOG  ·  NEWEST FIRST" Style="{StaticResource H}" />
                        <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Tester.Log}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="11" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
