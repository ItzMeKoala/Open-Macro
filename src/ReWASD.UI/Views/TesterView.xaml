<UserControl x:Class="ReWASD.UI.Views.TesterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:art="clr-namespace:ReWASD.UI.Art"
             xmlns:tc="clr-namespace:ReWASD.UI.TesterControls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9D1DE" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Bar" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="13" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource BrushCyan}" />
        </Style>
        <Style x:Key="Rule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#262B36" />
            <Setter Property="Margin" Value="0,10" />
        </Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E3E8F1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="Soft" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E9BAE" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Col" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6B7E" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="BorderBrush" Value="#262B35" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#171A21" />
        </Style>

        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Background" Value="#232833" />
            <Setter Property="Foreground" Value="#D5DCE8" />
            <Setter Property="BorderBrush" Value="#343B49" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#E9C46A" />
                                <Setter TargetName="b" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#232833" />
            <Setter Property="Foreground" Value="#D5DCE8" />
            <Setter Property="BorderBrush" Value="#343B49" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="c" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E9C46A" />
                                <Setter Property="Foreground" Value="#14161B" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#E9C46A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The bar that shows how far a trigger is pulled -->
        <Style x:Key="PressureBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#10131A" CornerRadius="7" />
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="7">
                                    <Border.Background>
                                        <SolidColorBrush Color="#E9C46A" />
                                    </Border.Background>
                                </Border>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style x:Key="ButtonRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDown}" Value="True"><Setter Property="Background" Value="#1A3B2C" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The reaction-test box: click inside it to start; it changes colour with the state of the game -->
        <Style x:Key="ReactBox" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#1B1F28" BorderBrush="#2A303C" BorderThickness="1" CornerRadius="14" MinHeight="80">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#E9C46A" /></Trigger>
                            <DataTrigger Binding="{Binding Tester.ReactionWait}" Value="True"><Setter TargetName="b" Property="Background" Value="#4A3A18" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tester.ReactionGo}" Value="True"><Setter TargetName="b" Property="Background" Value="#0E7A43" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tester.ReactionBad}" Value="True"><Setter TargetName="b" Property="Background" Value="#6B2323" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tester.ReactionDone}" Value="True"><Setter TargetName="b" Property="Background" Value="#1F3A5A" /></DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One trigger: how far it is pulled, and where along the pull it reported (a red mark is a stretch it skipped) -->
        <DataTemplate x:Key="TriggerPanel">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Style="{StaticResource Big}" FontSize="18" />
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar Style="{StaticResource PressureBar}" Minimum="0" Maximum="1" Value="{Binding Value, Mode=OneWay}" Height="12" Margin="0,6,0,8" />
                <tc:Histogram Height="56" Values="{Binding Travel}" StartLabel="0%" EndLabel="100% pull" FlagGaps="True" BarColor="#2EC4B6"
                              ToolTip="Pull the trigger slowly all the way. Each bar counts the readings in one twentieth of the pull; a red mark is a stretch the trigger jumped over." />
                <UniformGrid Columns="3" Margin="0,4,0,0">
                    <TextBlock Text="{Binding PeakText}" Style="{StaticResource Mono}" FontSize="11" />
                    <TextBlock Text="{Binding PressesText}" Style="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StepsText}" Style="{StaticResource Mono}" FontSize="11" Foreground="#8E9BAE" HorizontalAlignment="Right" />
                </UniformGrid>
            </StackPanel>
        </DataTemplate>

        <!-- The buttons on one half of the pad: state, count and hold times -->
        <DataTemplate x:Key="ButtonRows">
            <StackPanel>
                <Grid Margin="6,0,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /><ColumnDefinition Width="64" /><ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="BUTTON" Style="{StaticResource Col}" />
                    <TextBlock Grid.Column="2" Text="PRESSES" Style="{StaticResource Col}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="HOLD" Style="{StaticResource Col}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="SHORT – LONG" Style="{StaticResource Col}" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ButtonRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /><ColumnDefinition Width="64" /><ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="11" Height="11" Fill="Transparent" Stroke="#3A4150" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <Ellipse Width="11" Height="11" Fill="#2EF2A0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding IsDown, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Mono}" FontSize="11.5" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BounceText}" Style="{StaticResource Mono}" FontSize="10.5" Foreground="#FFAA00" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   ToolTip="A bounce is a release and press less than 30 ms apart: a worn switch, not a finger." />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding PressesText}" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding HoldText}" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding RangeText}" Style="{StaticResource Mono}" Foreground="#8E9BAE" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#0E1015">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar of the tester -->
        <Border Grid.Row="0" Padding="28,14" BorderBrush="#262B35" BorderThickness="0,0,0,1" Background="#14171D">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0" Background="{StaticResource BrushCyan}">
                        <Ellipse Width="22" Height="22" Stroke="#14161B" StrokeThickness="2.4" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CONTROLLER TESTER" FontSize="16" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding Tester.ControllerName}" FontSize="12.5" Foreground="#8E9BAE" />
                    </StackPanel>
                    <Border Style="{StaticResource Pill}" Background="#17402E" Visibility="{Binding Tester.Connected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="●  CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#2EF2A0" />
                    </Border>
                    <Border Background="#4A3A18">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tester.Connected}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="●  NO CONTROLLER" FontSize="10" FontWeight="Bold" Foreground="#FFAA00" />
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="#2E2A18" Visibility="{Binding Tester.IsPaused, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="PAUSED" FontSize="10" FontWeight="Bold" Foreground="#E9C46A" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,44,0"><TextBlock Text="SESSION" Style="{StaticResource Col}" /><TextBlock Text="{Binding Tester.SessionText}" Style="{StaticResource Big}" FontSize="20" /></StackPanel>
                    <StackPanel Margin="0,0,44,0"><TextBlock Text="REPORT RATE" Style="{StaticResource Col}" /><TextBlock Text="{Binding Tester.RateText}" Style="{StaticResource Big}" FontSize="20" /></StackPanel>
                    <StackPanel><TextBlock Text="CHANGES" Style="{StaticResource Col}" /><TextBlock Text="{Binding Tester.TotalText}" Style="{StaticResource Big}" FontSize="20" /></StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Tester.Notice}" Style="{StaticResource Soft}" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="260" />
                    <ToggleButton Content="Pause" Style="{StaticResource ChipToggle}" IsChecked="{Binding Tester.IsPaused, Mode=OneWay}" Command="{Binding ToggleTesterPauseCommand}" Margin="0,0,8,0" />
                    <Button Content="Copy report" Style="{StaticResource Chip}" Command="{Binding CopyTesterReportCommand}" Margin="0,0,8,0" />
                    <Button Content="Save report" Style="{StaticResource Chip}" Command="{Binding SaveTesterReportCommand}" Margin="0,0,8,0" />
                    <Button Content="Reset" Style="{StaticResource Chip}" Command="{Binding ResetTesterCommand}" Margin="0,0,8,0" />
                    <Button x:Name="ExitButton" Content="Close tester  (Esc)" Style="{StaticResource Chip}" Background="#E9C46A" Foreground="#14161B" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.25*" MinHeight="500" /><RowDefinition Height="*" MinHeight="200" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tile}" Margin="0,0,12,12" DataContext="{Binding Tester.Left}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource Chip}" Command="{Binding DataContext.ResetTesterLeftStickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Bar}" /><TextBlock Text="LEFT STICK" Style="{StaticResource H}" /></StackPanel>
                    </DockPanel>
                    <tc:StickPlot Grid.Row="1" MinHeight="110" Snapshot="{Binding Snapshot}" DeadzoneMin="{Binding DeadzoneMin}" DeadzoneMax="{Binding DeadzoneMax}" />
                    <TextBlock Grid.Row="2" Text="{Binding PositionText}" Style="{StaticResource Big}" FontSize="22" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <UniformGrid Grid.Row="3" Columns="2" Margin="0,8,0,0">
                        <StackPanel HorizontalAlignment="Center" ToolTip="How far the edge the stick reaches is from a perfect circle, on average. Under 10 % is healthy. Roll the stick slowly around its edge, all the way out, to measure it.">
                            <TextBlock Text="CIRCLE ERROR" Style="{StaticResource Col}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding RoundnessText}" Style="{StaticResource Val}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" ToolTip="How much of the circle the stick has been pushed all the way out to.">
                            <TextBlock Text="COVERAGE" Style="{StaticResource Col}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CoverageText}" Style="{StaticResource Val}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                    <Border Grid.Row="4" Style="{StaticResource Rule}" />
                    <ContentControl Grid.Row="5" ContentTemplate="{StaticResource ButtonRows}" Content="{Binding DataContext.Tester.LeftButtons, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid>
            </Border>

            <!-- THE CONTROLLER, and both triggers: pressure and travel -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tile}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Border Style="{StaticResource Bar}" /><TextBlock Text="LIVE" Style="{StaticResource H}" /></StackPanel>
                    <Border Grid.Row="1" CornerRadius="10" Padding="0,8" BorderBrush="#222733" BorderThickness="1" Background="#12151B">
                        <art:ArtView MinHeight="120" IsHitTestVisible="False" ShowEditing="False" Scene="{Binding SkinArt}" Sources="{Binding ControllerButtons}" />
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding PressedText}" Style="{StaticResource Mono}" HorizontalAlignment="Center" Margin="0,8,0,0" MinHeight="16" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,8"><Border Style="{StaticResource Bar}" /><TextBlock Text="TRIGGERS  ·  PRESSURE AND TRAVEL" Style="{StaticResource H}" /></StackPanel>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl ContentTemplate="{StaticResource TriggerPanel}" Content="{Binding Tester.LeftTrigger}" />
                        <ContentControl Grid.Column="2" ContentTemplate="{StaticResource TriggerPanel}" Content="{Binding Tester.RightTrigger}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Tile}" Margin="12,0,0,12" DataContext="{Binding Tester.Right}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource Chip}" Command="{Binding DataContext.ResetTesterRightStickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Bar}" /><TextBlock Text="RIGHT STICK" Style="{StaticResource H}" /></StackPanel>
                    </DockPanel>
                    <tc:StickPlot Grid.Row="1" MinHeight="110" Snapshot="{Binding Snapshot}" DeadzoneMin="{Binding DeadzoneMin}" DeadzoneMax="{Binding DeadzoneMax}" />
                    <TextBlock Grid.Row="2" Text="{Binding PositionText}" Style="{StaticResource Big}" FontSize="22" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <UniformGrid Grid.Row="3" Columns="2" Margin="0,8,0,0">
                        <StackPanel HorizontalAlignment="Center" ToolTip="How far the edge the stick reaches is from a perfect circle, on average. Under 10 % is healthy. Roll the stick slowly around its edge, all the way out, to measure it.">
                            <TextBlock Text="CIRCLE ERROR" Style="{StaticResource Col}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding RoundnessText}" Style="{StaticResource Val}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" ToolTip="How much of the circle the stick has been pushed all the way out to.">
                            <TextBlock Text="COVERAGE" Style="{StaticResource Col}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CoverageText}" Style="{StaticResource Val}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                    <Border Grid.Row="4" Style="{StaticResource Rule}" />
                    <ContentControl Grid.Row="5" ContentTemplate="{StaticResource ButtonRows}" Content="{Binding DataContext.Tester.RightButtons, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid>
            </Border>

            <!-- VIBRATION: two big motor buttons; "both motors" shakes both at once; "infinite" makes the shaking last until it is switched off -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tile}" Margin="0,0,12,0" Visibility="{Binding CanVibrate, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Style="{StaticResource Bar}" /><TextBlock Text="VIBRATION TEST" Style="{StaticResource H}" /></StackPanel>
                    <UniformGrid Grid.Row="1" Columns="2">
                        <Button Content="Left motor" Command="{Binding VibrateLeftCommand}" Style="{StaticResource Chip}" FontSize="17" FontWeight="SemiBold" Margin="0,0,6,0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip="Shake the left motor: the heavy, low rumble" />
                        <Button Content="Right motor" Command="{Binding VibrateRightCommand}" Style="{StaticResource Chip}" FontSize="17" FontWeight="SemiBold" Margin="6,0,0,0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip="Shake the right motor: the light, fine buzz" />
                    </UniformGrid>
                    <ToggleButton Grid.Row="2" Style="{StaticResource ToggleSwitchStyle}" Margin="0,12,0,0" IsChecked="{Binding VibrateBoth, Mode=TwoWay}"
                                  ToolTip="Shake both motors at once, for as long as a left or right test lasts">
                        <TextBlock Text="Both motors" />
                    </ToggleButton>
                    <ToggleButton Grid.Row="3" Style="{StaticResource ToggleSwitchStyle}" Margin="0,8,0,0" IsChecked="{Binding VibrateContinuously, Mode=TwoWay}"
                                  ToolTip="Make the motor buttons keep shaking until you switch this off, instead of for under a second">
                        <TextBlock Text="Infinite vibration" />
                    </ToggleButton>
                    <TextBlock Grid.Row="4" Text="Left, right and both motors shake for under a second. Infinite vibration keeps them shaking until you switch it off." Style="{StaticResource Soft}" FontSize="11" Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- GRAPH and TIMING -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="3*" /><RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Border Style="{StaticResource Bar}" /><TextBlock Text="LAST 6 SECONDS" Style="{StaticResource H}" /></StackPanel>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,6"><StackPanel Orientation="Horizontal" Margin="0,0,12,2"><Ellipse Width="9" Height="9" Fill="#E9C46A" Margin="0,0,5,0" /><TextBlock Text="Left X" Style="{StaticResource Soft}" FontSize="11" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,12,2"><Ellipse Width="9" Height="9" Fill="#F4A261" Margin="0,0,5,0" /><TextBlock Text="Left Y" Style="{StaticResource Soft}" FontSize="11" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,12,2"><Ellipse Width="9" Height="9" Fill="#5BC0EB" Margin="0,0,5,0" /><TextBlock Text="Right X" Style="{StaticResource Soft}" FontSize="11" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,12,2"><Ellipse Width="9" Height="9" Fill="#9B8CFF" Margin="0,0,5,0" /><TextBlock Text="Right Y" Style="{StaticResource Soft}" FontSize="11" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,12,2"><Ellipse Width="9" Height="9" Fill="#00E676" Margin="0,0,5,0" /><TextBlock Text="Left trigger" Style="{StaticResource Soft}" FontSize="11" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,12,2"><Ellipse Width="9" Height="9" Fill="#FF6B6B" Margin="0,0,5,0" /><TextBlock Text="Right trigger" Style="{StaticResource Soft}" FontSize="11" /></StackPanel></WrapPanel>
                        <tc:ScopeGraph Grid.Row="2" MinHeight="60" Series="{Binding Tester.Scope}" Channels="0,1,2,3" Minimum="-1" Maximum="1" ToolTip="Sticks, from −1 to +1" />
                        <tc:ScopeGraph Grid.Row="3" MinHeight="40" Margin="0,6,0,0" Series="{Binding Tester.Scope}" Channels="4,5" Minimum="0" Maximum="1" ToolTip="Triggers, from 0 to 1" />
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Border Style="{StaticResource Bar}" /><TextBlock Text="TIMING" Style="{StaticResource H}" /></StackPanel>
                        <TextBlock Grid.Row="1" Text="CHANGES PER SECOND" Style="{StaticResource Col}" />
                        <TextBlock Grid.Row="2" Text="{Binding Tester.RateNumberText}" Style="{StaticResource Big}" FontSize="26" Foreground="{StaticResource BrushCyan}" />
                        <TextBlock Grid.Row="3" Text="{Binding Tester.JitterText}" Style="{StaticResource Mono}" FontSize="11" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="4" Text="{Binding Tester.IntervalText}" Style="{StaticResource Mono}" FontSize="11" />
                        <tc:Histogram Grid.Row="5" MinHeight="50" Margin="0,8,0,0" Values="{Binding Tester.Histogram}" StartLabel="0 ms" EndLabel="40+ ms" BarColor="#E9C46A"
                                      ToolTip="Gaps between reports. Move a stick steadily: a tall, narrow spike means an even report rate; a spread or a bar far to the right means lag or dropped reports (Bluetooth is usually 60 – 250 a second, wired up to 1000)." />
                    </Grid>
                </Grid>
            </Border>

            <!-- REACTION -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Tile}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Style="{StaticResource Bar}" /><TextBlock Text="REACTION TEST" Style="{StaticResource H}" /></StackPanel>
                    <Button Grid.Row="1" Style="{StaticResource ReactBox}" Command="{Binding StartReactionTestCommand}" ToolTip="Includes up to one screen refresh (about 17 ms) before you see the signal.">
                        <TextBlock Text="{Binding Tester.ReactionText}" Style="{StaticResource Big}" FontSize="26" TextAlignment="Center" TextWrapping="Wrap" />
                    </Button>
                    <TextBlock Grid.Row="2" Text="{Binding Tester.ReactionDetail}" Style="{StaticResource Soft}" FontSize="11.5" Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
