<UserControl x:Class="ReWASD.UI.Views.MappingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ReWASD.UI.Converters"
             xmlns:vm="clr-namespace:ReWASD.UI.ViewModels;assembly=ReWASD.App"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="300">
    <UserControl.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:MappingModeLabelConverter x:Key="ModeLabel" />
        <conv:MacroRepeatLabelConverter x:Key="RepeatLabel" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <!-- The picture shown beside a choice: coloured letter, PlayStation symbol, keycap or icon -->
        <DataTemplate x:Key="RemapOptionTemplate" DataType="{x:Type vm:RemapOption}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Badge" Grid.Column="0" Height="26" MinWidth="26" HorizontalAlignment="Center" Padding="5,0" CornerRadius="13"
                        Background="#2A3140" BorderBrush="#3E485C" BorderThickness="1">
                    <TextBlock x:Name="Legend" Text="{Binding Legend}" Foreground="{Binding LegendColor}" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Shape}" Value="KeyCap">
                    <Setter TargetName="Badge" Property="CornerRadius" Value="5" />
                    <Setter TargetName="Badge" Property="MinWidth" Value="34" />
                    <Setter TargetName="Badge" Property="BorderThickness" Value="1,1,1,3" />
                    <Setter TargetName="Legend" Property="Foreground" Value="#E0E6EE" />
                    <Setter TargetName="Legend" Property="FontSize" Value="11" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Shape}" Value="Glyph">
                    <Setter TargetName="Legend" Property="FontFamily" Value="{StaticResource IconFont}" />
                    <Setter TargetName="Legend" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="Legend" Property="FontSize" Value="14" />
                    <Setter TargetName="Legend" Property="Foreground" Value="{StaticResource BrushCyan}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Shape}" Value="Pill">
                    <Setter TargetName="Badge" Property="MinWidth" Value="36" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,0,0" Padding="16,14">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Which input is being edited -->
                <TextBlock Text="{Binding SelectedButton.FriendlyName, FallbackValue='Nothing selected'}"
                           Foreground="{StaticResource BrushCyan}" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="{Binding SelectedButton.TargetText, StringFormat='Currently: {0}'}"
                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,2,0,0" />

                <!-- When it fires -->
                <TextBlock Text="WHEN" Style="{StaticResource SectionLabel}" />
                <UniformGrid Columns="3">
                    <RadioButton Content="Single" Style="{StaticResource ShiftTabButtonStyle}" ToolTip="One press"
                                 IsChecked="{Binding SelectedActivator, Converter={StaticResource EnumToBool}, ConverterParameter=Single}" />
                    <RadioButton Content="Long" Style="{StaticResource ShiftTabButtonStyle}" ToolTip="Held past the long-press time"
                                 IsChecked="{Binding SelectedActivator, Converter={StaticResource EnumToBool}, ConverterParameter=Long}" />
                    <RadioButton Content="Double" Style="{StaticResource ShiftTabButtonStyle}" ToolTip="Two quick presses"
                                 IsChecked="{Binding SelectedActivator, Converter={StaticResource EnumToBool}, ConverterParameter=Double}" />
                    <RadioButton Content="Triple" Style="{StaticResource ShiftTabButtonStyle}" ToolTip="Three quick presses"
                                 IsChecked="{Binding SelectedActivator, Converter={StaticResource EnumToBool}, ConverterParameter=Triple}" />
                    <RadioButton Content="Start" Style="{StaticResource ShiftTabButtonStyle}" ToolTip="The moment it goes down"
                                 IsChecked="{Binding SelectedActivator, Converter={StaticResource EnumToBool}, ConverterParameter=Start}" />
                    <RadioButton Content="Release" Style="{StaticResource ShiftTabButtonStyle}" ToolTip="When it is let go"
                                 IsChecked="{Binding SelectedActivator, Converter={StaticResource EnumToBool}, ConverterParameter=Release}" />
                </UniformGrid>

                <!-- What it does: remap to something, or run a macro -->
                <TextBlock Text="DO" Style="{StaticResource SectionLabel}" />
                <UniformGrid Columns="2">
                    <RadioButton Content="Remap" Style="{StaticResource ShiftTabButtonStyle}"
                                 IsChecked="{Binding TargetMode, Converter={StaticResource EnumToBool}, ConverterParameter=Remap}" />
                    <RadioButton Content="Macro" Style="{StaticResource ShiftTabButtonStyle}"
                                 IsChecked="{Binding TargetMode, Converter={StaticResource EnumToBool}, ConverterParameter=Macro}" />
                </UniformGrid>

                <!-- Remap: one dropdown with every choice -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRemapMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Remap to" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding RemapOptionsView}" SelectedItem="{Binding SelectedRemapOption}"
                              ItemTemplate="{StaticResource RemapOptionTemplate}" MaxDropDownHeight="380" Padding="8,5"
                              TextSearch.TextPath="Label" IsTextSearchEnabled="True"
                              ScrollViewer.CanContentScroll="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#1C212B" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,1"
                                                Padding="10,5" Margin="0,6,0,2">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                    </ComboBox>
                </StackPanel>

                <!-- Macro: record or type a sequence -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsMacroMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="● Record" Command="{Binding StartMacroRecordingCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="14,6" Margin="0,0,8,0" ToolTip="Record keys, mouse clicks and controller buttons with their timing" />
                        <Button Content="■ Stop" Command="{Binding StopMacroRecordingCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="14,6" ToolTip="Finish recording" />
                    </StackPanel>
                    <TextBlock Text="{Binding RecordingHint}" Foreground="{StaticResource BrushOrange}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBox Text="{Binding MacroScript, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="False" TextWrapping="Wrap" MinHeight="64"
                             Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushTextPrimary}"
                             BorderBrush="{StaticResource BrushBorder}" Padding="8,6" FontFamily="Consolas" FontSize="12"
                             ToolTip="One step per item, separated by semicolons, e.g. KeyDown:W; Delay:50; KeyUp:W" />
                    <TextBlock Text="{Binding MacroError}" Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding MacroStepTemplates}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,6"
                                        Command="{Binding DataContext.AddMacroStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MacroHelpText}" Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />

                    <TextBlock Text="Repeat" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,10,0,6" />
                    <ComboBox ItemsSource="{Binding AvailableMacroRepeatModes}" SelectedItem="{Binding SelectedMacroRepeat}" Padding="8,5"
                              ToolTip="Hold until released keeps everything the macro pressed held while you hold the button, which is how one button can press several others">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource RepeatLabel}}" Foreground="{StaticResource BrushTextPrimary}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- How it behaves once it fires -->
                <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionLabel}" />
                <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedMode}" Padding="8,5">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ModeLabel}}" Foreground="{StaticResource BrushTextPrimary}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsTurboMode, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock Text="Repeat every" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding TurboRateMs, StringFormat='{}{0} ms'}" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" FontSize="12" />
                    </DockPanel>
                    <Slider Minimum="20" Maximum="200" SmallChange="5" LargeChange="20" Value="{Binding TurboRateMs}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Actions -->
                <Button Content="SAVE" Command="{Binding SaveCurrentMappingCommand}"
                        Background="{StaticResource BrushCyan}" Foreground="#101318"
                        FontWeight="Bold" FontSize="13"
                        HorizontalAlignment="Stretch" Height="38" Margin="0,20,0,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCyanHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCyanDark}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Reset to default" Command="{Binding ResetCurrentMappingCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch" Height="38" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
