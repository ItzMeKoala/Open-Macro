<UserControl x:Class="ReWASD.UI.Views.MappingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ReWASD.UI.Converters"
             xmlns:vm="clr-namespace:ReWASD.UI.ViewModels;assembly=ReWASD.App"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="300">
    <UserControl.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:MappingModeLabelConverter x:Key="ModeLabel" />
        <conv:MacroRepeatLabelConverter x:Key="RepeatLabel" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <!-- The picture shown beside a choice: coloured letter, PlayStation symbol, keycap or icon -->
        <DataTemplate x:Key="RemapOptionTemplate" DataType="{x:Type vm:RemapOption}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Badge" Grid.Column="0" Height="26" MinWidth="26" HorizontalAlignment="Center" Padding="5,0" CornerRadius="13"
                        Background="#2A3140" BorderBrush="#3E485C" BorderThickness="1">
                    <TextBlock x:Name="Legend" Text="{Binding Legend}" Foreground="{Binding LegendColor}" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Shape}" Value="KeyCap">
                    <Setter TargetName="Badge" Property="CornerRadius" Value="5" />
                    <Setter TargetName="Badge" Property="MinWidth" Value="34" />
                    <Setter TargetName="Badge" Property="BorderThickness" Value="1,1,1,3" />
                    <Setter TargetName="Legend" Property="Foreground" Value="#E0E6EE" />
                    <Setter TargetName="Legend" Property="FontSize" Value="11" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Shape}" Value="Glyph">
                    <Setter TargetName="Legend" Property="FontFamily" Value="{StaticResource IconFont}" />
                    <Setter TargetName="Legend" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="Legend" Property="FontSize" Value="14" />
                    <Setter TargetName="Legend" Property="Foreground" Value="{StaticResource BrushCyan}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Shape}" Value="Pill">
                    <Setter TargetName="Badge" Property="MinWidth" Value="36" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Which input is being edited, and what it does now -->
            <StackPanel Grid.Row="0" Margin="16,16,16,8">
                <DockPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="8" Padding="8,2" VerticalAlignment="Center" Background="#2A2412"
                            Visibility="{Binding SelectedIsRemapped, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Remapped" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" />
                    </Border>
                    <TextBlock Text="{Binding SelectedButton.FriendlyName, FallbackValue='Pick an input'}" Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding SelectedSummary}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,0,16,16">

                    <!-- When it fires: a dot marks the triggers that already do something -->
                    <TextBlock Text="Trigger" Style="{StaticResource FieldLabel}" Margin="0,4,0,8" />
                    <ItemsControl ItemsSource="{Binding ActivatorChoices}" Margin="0,0,-8,-8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SegButtonStyle}" ToolTip="{Binding Help}" Tag="{Binding IsSelected}"
                                        Command="{Binding DataContext.ChooseActivatorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" />
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource BrushCyan}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                 Visibility="{Binding HasMapping, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- What it does -->
                    <TextBlock Text="Action" Style="{StaticResource FieldLabel}" />
                    <UniformGrid Columns="3" Margin="0,0,-8,-8">
                        <RadioButton Content="Remap" Style="{StaticResource SegRadioStyle}" GroupName="ActionMode" ToolTip="Send another button, key or mouse action"
                                     IsChecked="{Binding TargetMode, Converter={StaticResource EnumToBool}, ConverterParameter=Remap}" />
                        <RadioButton Content="Macro" Style="{StaticResource SegRadioStyle}" GroupName="ActionMode" ToolTip="Run a sequence of steps"
                                     IsChecked="{Binding TargetMode, Converter={StaticResource EnumToBool}, ConverterParameter=Macro}" />
                        <RadioButton Content="Script" Style="{StaticResource SegRadioStyle}" GroupName="ActionMode" ToolTip="Write a small JavaScript program for this input"
                                     IsChecked="{Binding TargetMode, Converter={StaticResource EnumToBool}, ConverterParameter=Script}" />
                    </UniformGrid>

            <!-- Remap: one dropdown with every choice -->
            <StackPanel Visibility="{Binding IsRemapMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Send" Style="{StaticResource FieldLabel}" />
                
                <ComboBox ItemsSource="{Binding RemapOptionsView}" SelectedItem="{Binding SelectedRemapOption}"
                          ItemTemplate="{StaticResource RemapOptionTemplate}" MaxDropDownHeight="380"
                          TextSearch.TextPath="Label" IsTextSearchEnabled="True"
                          ScrollViewer.CanContentScroll="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ComboBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#1C212B" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,1"
                                            Padding="10,5" Margin="0,6,0,2">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ComboBox.GroupStyle>
                </ComboBox>
            </StackPanel>

            <!-- Script: a small JavaScript program -->
            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsScriptMode, Converter={StaticResource BoolToVisibility}}">
                <TextBox Text="{Binding ScriptCode, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" MinHeight="150" MaxHeight="260"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushTextPrimary}"
                         BorderBrush="{StaticResource BrushBorder}" Padding="8,6" FontFamily="Consolas" FontSize="12"
                         ToolTip="press('A'); hold('W'); click(); type('hi'); delay(100); shell('...'); openURL('...'); webhook('POST', url, body); obs('StartRecord'); notify('...'); app.name; state.x" />
                <TextBlock Text="{Binding ScriptError}" Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="Examples" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,8,0,4" />
                <ItemsControl ItemsSource="{Binding ScriptExamples}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,6"
                                    Command="{Binding DataContext.UseScriptExampleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Functions: press, hold, release, click, mouseDown, mouseUp, scroll, moveMouse, type, delay, shell, openURL, openApp, webhook, obs, padPress, padHold, padRelease, notify. Objects: app (name, id, is), state (kept between runs)." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" />
                <TextBlock Text="Repeat" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding AvailableMacroRepeatModes}" SelectedItem="{Binding SelectedMacroRepeat}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource RepeatLabel}}" Foreground="{StaticResource BrushTextPrimary}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Macro: record or type a sequence -->
            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsMacroMode, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="● Record" Command="{Binding StartMacroRecordingCommand}" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,6" Margin="0,0,8,0" ToolTip="Record keys, mouse clicks and controller buttons with their timing" />
                    <Button Content="■ Stop" Command="{Binding StopMacroRecordingCommand}" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,6" ToolTip="Finish recording" />
                </StackPanel>
                <TextBlock Text="{Binding RecordingHint}" Foreground="{StaticResource BrushOrange}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />

                <TextBox Text="{Binding MacroScript, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="False" TextWrapping="Wrap" MinHeight="64"
                         Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushTextPrimary}"
                         BorderBrush="{StaticResource BrushBorder}" Padding="8,6" FontFamily="Consolas" FontSize="12"
                         ToolTip="One step per item, separated by semicolons, e.g. KeyDown:W; Delay:50; KeyUp:W" />
                <TextBlock Text="{Binding MacroError}" Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                <ItemsControl ItemsSource="{Binding MacroStepTemplates}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,6"
                                    Command="{Binding DataContext.AddMacroStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding MacroHelpText}" Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />

                <TextBlock Text="Repeat" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding AvailableMacroRepeatModes}" SelectedItem="{Binding SelectedMacroRepeat}"
                          ToolTip="Hold until released keeps everything the macro pressed held while you hold the button, which is how one button can press several others">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource RepeatLabel}}" Foreground="{StaticResource BrushTextPrimary}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>


                    <!-- How it acts once it fires -->
                    <TextBlock Text="Behaviour" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedMode}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ModeLabel}}" Foreground="{StaticResource BrushTextPrimary}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding ModeDescription}" Foreground="{StaticResource BrushTextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsTurboMode, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TurboRateMs, StringFormat='{}{0} ms'}" Foreground="{StaticResource BrushCyan}" FontSize="12" />
                            <TextBlock Text="Repeat every" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                        </DockPanel>
                        <Slider Minimum="20" Maximum="200" SmallChange="5" LargeChange="20" Value="{Binding TurboRateMs}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Always in view: save, and start over -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCurrentMappingCommand}" IsEnabled="{Binding IsInspectorDirty}"
                                Background="{StaticResource BrushCyan}" Foreground="#101318" FontWeight="Bold" FontSize="13" Height="36" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCyanHover}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCyanDark}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#26262A" />
                                            <Setter Property="Foreground" Value="#6B7587" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="1" Content="Reset" Command="{Binding ResetCurrentMappingCommand}" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"
                                ToolTip="Put this button back to doing its own job" />
                    </Grid>
                    <TextBlock Text="Changes are also saved when you click another button." Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="{Binding IsInspectorDirty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
