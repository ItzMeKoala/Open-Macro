<UserControl x:Class="ReWASD.UI.Views.MappingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:ReWASD.Core.Models;assembly=ReWASD.Core"
             xmlns:conv="clr-namespace:ReWASD.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="300">
    <UserControl.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
    </UserControl.Resources>
    <Border Background="{StaticResource BrushBgPanel}" 
            BorderBrush="{StaticResource BrushBorder}" 
            BorderThickness="1,0,0,0" 
            Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Header: Selected Button Info -->
                <Border Background="{StaticResource BrushBgCard}" 
                        BorderBrush="{StaticResource BrushBorderLight}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="SELECTED CONTROL" 
                                   Foreground="{StaticResource BrushTextMuted}" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedButton.DisplayName, FallbackValue='None'}" 
                                   Foreground="{StaticResource BrushCyan}" 
                                   FontSize="20" 
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedButton.TargetText, StringFormat='Mapped to: {0}'}" 
                                   Foreground="{StaticResource BrushTextSecondary}" 
                                   FontSize="12" 
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Activator: when the mapping fires -->
                <TextBlock Text="WHEN"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="0,12,0,0" />
                <UniformGrid Columns="3" Margin="0,4">
                    <RadioButton Content="Single" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,4"
                                 ToolTip="One press"
                                 IsChecked="{Binding SelectedActivator, Converter={StaticResource EnumToBool}, ConverterParameter=Single}" />
                    <RadioButton Content="Long" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,4"
                                 ToolTip="Held past the long-press time"
                                 IsChecked="{Binding SelectedActivator, Converter={StaticResource EnumToBool}, ConverterParameter=Long}" />
                    <RadioButton Content="Double" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,0,4"
                                 ToolTip="Two quick presses"
                                 IsChecked="{Binding SelectedActivator, Converter={StaticResource EnumToBool}, ConverterParameter=Double}" />
                    <RadioButton Content="Triple" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,0"
                                 ToolTip="Three quick presses"
                                 IsChecked="{Binding SelectedActivator, Converter={StaticResource EnumToBool}, ConverterParameter=Triple}" />
                    <RadioButton Content="Start" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,0"
                                 ToolTip="The moment the button goes down, before anything else is decided"
                                 IsChecked="{Binding SelectedActivator, Converter={StaticResource EnumToBool}, ConverterParameter=Start}" />
                    <RadioButton Content="Release" Style="{StaticResource ShiftTabButtonStyle}"
                                 ToolTip="When the button is let go"
                                 IsChecked="{Binding SelectedActivator, Converter={StaticResource EnumToBool}, ConverterParameter=Release}" />
                </UniformGrid>
                <TextBlock Text="Long, Double and Triple make Single wait to see what follows."
                           Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" />

                <!-- Remap Category Selector -->
                <TextBlock Text="REMAP TARGET"
                           Foreground="{StaticResource BrushTextMuted}" 
                           FontSize="11" 
                           FontWeight="Bold" />

                <!-- Controller / Keyboard / Mouse Category Tabs -->
                <UniformGrid Columns="4" Margin="0,4">
                    <RadioButton Content="None" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,4"
                                 ToolTip="Single: swallow the input. Other activators: no outcome."
                                 IsChecked="{Binding SelectedTargetType, Converter={StaticResource EnumToBool}, ConverterParameter=None}" />
                    <RadioButton Content="Pad" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,4"
                                 IsChecked="{Binding SelectedTargetType, Converter={StaticResource EnumToBool}, ConverterParameter=VirtualControllerButton}" />
                    <RadioButton Content="Key" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,4"
                                 IsChecked="{Binding SelectedTargetType, Converter={StaticResource EnumToBool}, ConverterParameter=KeyboardKey}" />
                    <RadioButton Content="Mouse" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,0,4"
                                 IsChecked="{Binding SelectedTargetType, Converter={StaticResource EnumToBool}, ConverterParameter=MouseButton}" />
                    <RadioButton Content="Scroll" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,0"
                                 IsChecked="{Binding SelectedTargetType, Converter={StaticResource EnumToBool}, ConverterParameter=MouseScroll}" />
                    <RadioButton Content="Macro" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,0"
                                 IsChecked="{Binding SelectedTargetType, Converter={StaticResource EnumToBool}, ConverterParameter=Macro}" />
                    <RadioButton Content="Layer" Style="{StaticResource ShiftTabButtonStyle}" Margin="0,0,4,0"
                                 ToolTip="Switch to a layer while this fires"
                                 IsChecked="{Binding SelectedTargetType, Converter={StaticResource EnumToBool}, ConverterParameter=JumpToLayer}" />
                </UniformGrid>

                <!-- Virtual Controller Target Selection -->
                <StackPanel Margin="0,4">
                    <TextBlock Text="Virtual Controller Button" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               FontSize="12" 
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AvailableVirtualButtons}" 
                              SelectedItem="{Binding SelectedVirtualButton}"
                              Background="{StaticResource BrushBgCard}"
                              Foreground="{StaticResource BrushTextPrimary}"
                              BorderBrush="{StaticResource BrushBorder}"
                              Padding="8,6" />
                </StackPanel>

                <!-- Keyboard Key Selection -->
                <StackPanel Margin="0,4">
                    <TextBlock Text="Or Keyboard Key" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               FontSize="12" 
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AvailableKeyboardKeys}" 
                              SelectedItem="{Binding SelectedKeyboardKey}"
                              Background="{StaticResource BrushBgCard}"
                              Foreground="{StaticResource BrushTextPrimary}"
                              BorderBrush="{StaticResource BrushBorder}"
                              Padding="8,6" />
                </StackPanel>

                <!-- Mouse Button Selection -->
                <StackPanel Margin="0,4">
                    <TextBlock Text="Or Mouse Action" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               FontSize="12" 
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AvailableMouseButtons}" 
                              SelectedItem="{Binding SelectedMouseButton}"
                              Background="{StaticResource BrushBgCard}"
                              Foreground="{StaticResource BrushTextPrimary}"
                              BorderBrush="{StaticResource BrushBorder}"
                              Padding="8,6" />
                </StackPanel>

                <!-- Scroll Direction -->
                <StackPanel Margin="0,4">
                    <TextBlock Text="Or Mouse Scroll"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AvailableScrollDirections}"
                              SelectedItem="{Binding SelectedScrollDirection}"
                              Background="{StaticResource BrushBgCard}"
                              Foreground="{StaticResource BrushTextPrimary}"
                              BorderBrush="{StaticResource BrushBorder}"
                              Padding="8,6" />
                </StackPanel>

                <!-- Jump to layer -->
                <StackPanel Margin="0,4">
                    <TextBlock Text="Or Jump to Layer"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding LayerNames}"
                              SelectedIndex="{Binding SelectedJumpLayer, Mode=TwoWay}"
                              Background="{StaticResource BrushBgCard}"
                              Foreground="{StaticResource BrushTextPrimary}"
                              BorderBrush="{StaticResource BrushBorder}"
                              Padding="8,6" />
                </StackPanel>

                <!-- Macro Editor -->
                <StackPanel Margin="0,4">
                    <TextBlock Text="Or Macro (Action:Value; ...)"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding MacroScript, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="False" TextWrapping="Wrap" MinHeight="48"
                             Background="{StaticResource BrushBgCard}"
                             Foreground="{StaticResource BrushTextPrimary}"
                             BorderBrush="{StaticResource BrushBorder}"
                             Padding="8,6" />
                    <ComboBox ItemsSource="{Binding AvailableMacroRepeatModes}"
                              SelectedItem="{Binding SelectedMacroRepeat}"
                              Background="{StaticResource BrushBgCard}"
                              Foreground="{StaticResource BrushTextPrimary}"
                              BorderBrush="{StaticResource BrushBorder}"
                              Padding="8,6" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding MacroError}" Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text="Keys and mouse: KeyDown:W  KeyUp:W  KeyTap:E  MouseDown:Left Click  MouseUp:…  MouseClick:…  Wheel:-2  MouseMove:right:40" />
                        <LineBreak />
                        <Run Text="Pad: PadDown:A  PadUp:A  PadTap:B  PadAxis:LeftStickX:80 (-100..100)  Rumble:80,60:200 (left,right % : ms)" />
                        <LineBreak />
                        <Run Text="Flow: Delay:50  Break (ends the macro)" />
                    </TextBlock>
                </StackPanel>

                <!-- Mapping Behavior (Mode) -->
                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Margin="0,8" />

                <TextBlock Text="MAPPING BEHAVIOR" 
                           Foreground="{StaticResource BrushTextMuted}" 
                           FontSize="11" 
                           FontWeight="Bold" />

                <ComboBox ItemsSource="{Binding AvailableModes}"
                          SelectedItem="{Binding SelectedMode}"
                          Background="{StaticResource BrushBgCard}"
                          Foreground="{StaticResource BrushTextPrimary}"
                          BorderBrush="{StaticResource BrushBorder}"
                          Padding="8,6" Margin="0,4" />

                <!-- Turbo Rate Slider -->
                <StackPanel Margin="0,4">
                    <DockPanel>
                        <TextBlock Text="Turbo Pause / Repeat" 
                                   Foreground="{StaticResource BrushTextSecondary}" 
                                   FontSize="12" />
                        <TextBlock Text="{Binding TurboRateMs, StringFormat='{}{0} ms'}" 
                                   Foreground="{StaticResource BrushCyan}" 
                                   HorizontalAlignment="Right" 
                                   FontSize="12" />
                    </DockPanel>
                    <Slider Minimum="20" Maximum="200" SmallChange="5" LargeChange="20"
                            Value="{Binding TurboRateMs}" 
                            Margin="0,6,0,0" />
                </StackPanel>

                <!-- Mute Original Input Checkbox -->
                <CheckBox Content="Mute original hardware input" 
                          IsChecked="{Binding IsMuted}" 
                          Foreground="{StaticResource BrushTextPrimary}" 
                          Margin="0,6" />

                <!-- Action Buttons -->
                <StackPanel Orientation="Vertical" Margin="0,16,0,0">
                    <Button Content="SAVE MAPPING" 
                            Command="{Binding SaveCurrentMappingCommand}"
                            Background="{StaticResource BrushCyan}"
                            Foreground="#101318"
                            FontWeight="Bold"
                            Padding="0,10"
                            Margin="0,0,0,8"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Reset to Default" 
                            Command="{Binding ResetCurrentMappingCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
